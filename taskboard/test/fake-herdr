#!/usr/bin/env bash
# 疑似 herdr。FAKE_STATUS(既定 idle。missing なら agent_not_found) / FAKE_PROMPT_RC / FAKE_LOG を使う
case "$1 $2" in
  "agent get")
    echo "get $3" >>"${FAKE_LOG:?}"
    if [[ ${FAKE_STATUS:-idle} == missing ]]; then
      echo '{"error":{"code":"agent_not_found","message":"not found"}}'; exit 1
    fi
    echo "{\"result\":{\"agent\":{\"agent_status\":\"${FAKE_STATUS:-idle}\"},\"type\":\"agent_info\"}}";;
  "agent list")
    echo "list" >>"${FAKE_LOG:?}"
    [[ ${FAKE_LIST_FAIL:-0} == 1 ]] && { echo '{"error":{"code":"x"}}'; exit 1; }
    # FAKE_AGENTS(JSON 配列)で差し替え可。既定は worker1(wW:p1) と名前なし(wW:p2)
    default='[{"pane_id":"wW:p1","name":"worker1","agent_session":{"value":"sess-w1"}},{"pane_id":"wW:p2","agent_session":{"value":"sess-w2"}}]'
    printf '{"result":{"agents":%s},"type":"agent_list"}\n' "${FAKE_AGENTS:-$default}";;
  "agent prompt")
    printf 'prompt %s\t%s\n' "$3" "$4" >>"${FAKE_LOG:?}"
    if [[ ${FAKE_PROMPT_RC:-0} != 0 ]]; then echo '{"error":{"code":"x"}}'; exit "$FAKE_PROMPT_RC"; fi
    echo '{"result":{"type":"ok"}}';;
  "workspace create")
    echo "workspace-create $*" >>"${FAKE_LOG:?}"
    [[ ${FAKE_WS_FAIL:-0} == 1 ]] && { echo '{"error":{"code":"x"}}'; exit 1; }
    echo '{"result":{"root_pane":{"pane_id":"wA:p1"}}}';;
  "agent start")
    printf 'start %s\n' "$3" >>"${FAKE_LOG:?}"
    exit "${FAKE_START_RC:-0}";;
  *) echo "fake-herdr: unsupported: $*" >&2; exit 99;;
esac
