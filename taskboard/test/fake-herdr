#!/usr/bin/env bash
# 疑似 herdr。FAKE_STATUS(既定 idle。missing なら agent_not_found) / FAKE_PROMPT_RC / FAKE_LOG を使う
case "$1 $2" in
  "agent get")
    echo "get $3" >>"${FAKE_LOG:?}"
    [[ -n ${FAKE_SESSION_LOG:-} ]] && echo "session=${HERDR_SESSION:-}" >>"$FAKE_SESSION_LOG"
    if [[ ${FAKE_STATUS:-idle} == missing ]]; then
      echo '{"error":{"code":"agent_not_found","message":"not found"}}'; exit 1
    fi
    # FAKE_READY_AFTER=N: 最初の N 回の get は interactive_ready=false(起動直後の UI 未準備)
    ready=true
    if [[ -n ${FAKE_READY_AFTER:-} ]]; then
      n=$(( $(cat "$FAKE_LOG.ready" 2>/dev/null || echo 0) + 1 )); echo "$n" >"$FAKE_LOG.ready"
      (( n > FAKE_READY_AFTER )) || ready=false
    fi
    st=${FAKE_STATUS:-idle}
    [[ -e $FAKE_LOG.working ]] && st=working   # 送信が受け付けられた後(FAKE_PROMPT_MODE)
    echo "{\"result\":{\"agent\":{\"agent_status\":\"$st\",\"interactive_ready\":$ready},\"type\":\"agent_info\"}}";;
  "agent send-keys")
    printf 'keys %s\t%s\n' "$3" "${*:4}" >>"${FAKE_LOG:?}"
    # swallow-once: 失われた Enter の代わりに、これで初めて送信される(= 動き出す)
    [[ ${FAKE_PROMPT_MODE:-} == swallow-once && $4 == Enter ]] && : >"$FAKE_LOG.working"
    echo '{"result":{"type":"ok"}}';;
  "agent list")
    echo "list" >>"${FAKE_LOG:?}"
    [[ ${FAKE_LIST_FAIL:-0} == 1 ]] && { echo '{"error":{"code":"x"}}'; exit 1; }
    # FAKE_AGENTS(JSON 配列)で差し替え可。既定は worker1(wW:p1) と名前なし(wW:p2)
    default='[{"pane_id":"wW:p1","name":"worker1","agent_session":{"value":"sess-w1"}},{"pane_id":"wW:p2","agent_session":{"value":"sess-w2"}}]'
    printf '{"result":{"agents":%s},"type":"agent_list"}\n' "${FAKE_AGENTS:-$default}";;
  "agent prompt")
    printf 'prompt %s\t%s\n' "$3" "$4" >>"${FAKE_LOG:?}"
    if [[ ${FAKE_PROMPT_RC:-0} != 0 ]]; then echo '{"error":{"code":"x"}}'; exit "$FAKE_PROMPT_RC"; fi
    # FAKE_PROMPT_MODE: work=受け付けられて動き出す / swallow-once=Enter が失われ send-keys Enter で動く / swallow-always=動かない
    [[ ${FAKE_PROMPT_MODE:-} == work ]] && : >"$FAKE_LOG.working"
    echo '{"result":{"type":"ok"}}';;
  "workspace create")
    echo "workspace-create $*" >>"${FAKE_LOG:?}"
    [[ ${FAKE_WS_FAIL:-0} == 1 ]] && { echo '{"error":{"code":"x"}}'; exit 1; }
    echo "{\"result\":{\"workspace\":{\"workspace_id\":\"wN\"},\"root_pane\":{\"pane_id\":\"${FAKE_NEW_PANE:-wA:p1}\"}}}";;
  "workspace list")
    echo "workspace-list" >>"${FAKE_LOG:?}"
    [[ ${FAKE_WS_LIST_FAIL:-0} == 1 ]] && { echo '{"error":{"code":"x"}}'; exit 1; }
    # FAKE_WORKSPACES(JSON 配列。例 [{"label":"inc-001"}])。既定は空
    printf '{"result":{"workspaces":%s},"type":"workspace_list"}\n' "${FAKE_WORKSPACES:-[]}";;
  "workspace close")
    echo "workspace-close $3" >>"${FAKE_LOG:?}";;
  "pane close")
    echo "pane-close $3" >>"${FAKE_LOG:?}"
    exit "${FAKE_CLOSE_RC:-0}";;
  "agent start")
    printf 'start %s\n' "${*:3}" >>"${FAKE_LOG:?}"
    exit "${FAKE_START_RC:-0}";;
  *) echo "fake-herdr: unsupported: $*" >&2; exit 99;;
esac
