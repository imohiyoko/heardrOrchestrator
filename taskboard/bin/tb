#!/usr/bin/env bash
# tb — herdr agent 用の最小タスク表(SQLite 1 ファイル)
# usage: tb {add|list|show|claim|update|done|block|report|pending|proxy-*|touch|activity|comment|comments} ...  (tb help で詳細)
#
# 環境変数: TB_DB(DB パス) / TB_CONFIG(projects.conf) / HERDR_BIN(herdr の実体。テストでは疑似 herdr)
# 終了コード: 0 成功 / 1 エラー / 2 使い方の誤り
#             report のみ: 10 宛先が使用中などで未送信(pending に残る) / 11 送信・状態取得に失敗(pending に残る)
set -euo pipefail

TB_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
DB=${TB_DB:-$TB_ROOT/data/tasks.db}
CONF=${TB_CONFIG:-$TB_ROOT/config/projects.conf}
HERDR_BIN=${HERDR_BIN:-herdr}
DEFAULT_TARGET=conductor
STATUSES="todo in_progress review done blocked"

die()   { echo "tb: $*" >&2; exit 1; }
usage() { echo "tb: $*" >&2; echo "(tb help で使い方)" >&2; exit 2; }

need_tools() {
  command -v sqlite3 >/dev/null || die "sqlite3 が必要です"
  command -v jq >/dev/null || die "jq が必要です"
}

sql() { sqlite3 -bail -batch -cmd ".timeout ${SQL_TIMEOUT:-5000}" "$DB" "$@"; }
q()   { local s=${1//\'/\'\'}; printf "'%s'" "$s"; }          # SQL 文字列リテラル化
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

init_db() {
  mkdir -p "$(dirname "$DB")"
  sql "CREATE TABLE IF NOT EXISTS tasks (
    id           TEXT PRIMARY KEY,
    project      TEXT NOT NULL,
    title        TEXT NOT NULL,
    owner_agent  TEXT,
    session_id   TEXT,
    account      TEXT,
    status       TEXT NOT NULL DEFAULT 'todo'
                 CHECK (status IN ('todo','in_progress','review','done','blocked')),
    parent_id    TEXT,
    deliverables TEXT NOT NULL DEFAULT '[]',   -- JSON 配列
    summary      TEXT,                          -- done 時の要約
    note         TEXT,                          -- block 理由など
    reported_at  TEXT,                          -- report 成功時のみ埋まる
    created_at   TEXT NOT NULL,
    updated_at   TEXT NOT NULL
  );
  CREATE INDEX IF NOT EXISTS tasks_project_status ON tasks(project, status);
  CREATE TABLE IF NOT EXISTS proxy_requests (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    task_id    TEXT NOT NULL,
    cmd        TEXT NOT NULL,
    why        TEXT NOT NULL,
    effect     TEXT NOT NULL CHECK (effect IN ('read-only','write','external')),
    expect     TEXT,
    status     TEXT NOT NULL DEFAULT 'open'
               CHECK (status IN ('open','done','pending-human','denied')),
    result     TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
  );
  CREATE INDEX IF NOT EXISTS proxy_requests_status ON proxy_requests(status);
  CREATE TABLE IF NOT EXISTS comments (
    id           INTEGER PRIMARY KEY AUTOINCREMENT,
    task_id      TEXT NOT NULL,
    kind         TEXT NOT NULL CHECK (kind IN ('done','progress','question','blocked')),
    text         TEXT NOT NULL,
    deliverables TEXT NOT NULL DEFAULT '[]',   -- JSON 配列(done で必須)
    from_name    TEXT NOT NULL,                 -- herdr agent list から引いた値(自己申告ではない)
    from_pane    TEXT NOT NULL,
    from_session TEXT NOT NULL,
    delivered_at TEXT,                          -- 宛先へ送れたときだけ埋まる
    created_at   TEXT NOT NULL,
    resolved_at  TEXT,                          -- 人が tb resolve で畳んだ時刻(question/blocked のみ)
    resolved_note TEXT
  );
  CREATE INDEX IF NOT EXISTS comments_task ON comments(task_id);
  CREATE TABLE IF NOT EXISTS agent_activity (
    session_id     TEXT PRIMARY KEY,
    pane_id        TEXT,
    tab_id         TEXT,
    workspace_id   TEXT,
    cwd            TEXT,
    last_prompt_id TEXT,
    last_prompt_at TEXT,    -- UserPromptSubmit の時刻(UTC, ミリ秒)
    last_stop_at   TEXT,    -- Stop の時刻
    updated_at     TEXT NOT NULL
  );" >/dev/null || return 1
  # 既存 DB の移行(冪等): comments に resolved_at / resolved_note が無ければ足す
  local col
  for col in resolved_at resolved_note; do
    if [[ $(sql "SELECT count(*) FROM pragma_table_info('comments') WHERE name='$col';") == 0 ]]; then
      sql "ALTER TABLE comments ADD COLUMN $col TEXT;" >/dev/null 2>&1 || true   # 同時実行で先に足された場合は無視
    fi
  done
}

valid_id()      { [[ $1 =~ ^T-[A-Za-z0-9_]+-[0-9]{3,}$ ]] || usage "タスク ID は T-<project>-NNN 形式: $1"; }
valid_project() { [[ $1 =~ ^[A-Za-z0-9_]+$ ]] || usage "project は英数字と _ のみ: $1"; }
valid_status()  { [[ " $STATUSES " == *" $1 "* ]] || usage "status は $STATUSES のどれか: $1"; }
need_arg()      { [[ $# -ge 2 ]] || usage "$1 に値が必要です"; }
blank()         { [[ -z "${1//[[:space:]]/}" ]]; }

task_row() {  # $1=id → JSON 1 行(なければ空)
  sql -json "SELECT * FROM tasks WHERE id=$(q "$1");" | jq -c '.[0] // empty'
}
require_task() { local r; r=$(task_row "$1"); [[ -n $r ]] || die "タスクが見つかりません: $1"; printf '%s' "$r"; }

target_for() {  # $1=project → 指示役の名前
  local t=$DEFAULT_TARGET k v
  if [[ -f $CONF ]]; then
    while IFS='=' read -r k v || [[ -n $k ]]; do
      k=${k//[[:space:]]/}; v=${v//[[:space:]]/}
      [[ -z $k || $k == \#* ]] && continue
      [[ $k == "$1" && -n $v ]] && t=$v
    done <"$CONF"
  fi
  printf '%s' "$t"
}

# ---------- add ----------
cmd_add() {
  local project="" title="" parent="" owner="" session="" account=""
  while [[ $# -gt 0 ]]; do
    case $1 in
      -p|--project) need_arg "$@"; project=$2; shift 2;;
      -t|--title)   need_arg "$@"; title=$2; shift 2;;
      --parent)     need_arg "$@"; parent=$2; shift 2;;
      --owner)      need_arg "$@"; owner=$2; shift 2;;
      --session)    need_arg "$@"; session=$2; shift 2;;
      --account)    need_arg "$@"; account=$2; shift 2;;
      *) usage "add: 不明な引数 $1";;
    esac
  done
  [[ -n $project ]] || usage "add: -p <project> が必要です"
  valid_project "$project"
  blank "$title" && usage "add: -t <title> が必要です"
  if [[ -n $parent ]]; then valid_id "$parent"; require_task "$parent" >/dev/null; fi
  local n=$(now) p; p=$(q "$project")
  # 採番と挿入を 1 文で行い、同時 add でも重複しないようにする
  sql "INSERT INTO tasks (id, project, title, owner_agent, session_id, account, parent_id, created_at, updated_at)
       SELECT 'T-'||$p||'-'||printf('%03d', COALESCE(MAX(CAST(substr(id, length($p)+4) AS INTEGER)),0)+1),
              $p, $(q "$title"), NULLIF($(q "$owner"),''), NULLIF($(q "$session"),''), NULLIF($(q "$account"),''),
              NULLIF($(q "$parent"),''), $(q "$n"), $(q "$n")
       FROM tasks WHERE project=$p;
       SELECT id FROM tasks WHERE rowid=last_insert_rowid();"
}

# ---------- list ----------
cmd_list() {
  local project="" status="" json=0 where="1=1"
  while [[ $# -gt 0 ]]; do
    case $1 in
      -p|--project) need_arg "$@"; project=$2; shift 2;;
      -s|--status)  need_arg "$@"; status=$2; shift 2;;
      --json)       json=1; shift;;
      *) usage "list: 不明な引数 $1";;
    esac
  done
  [[ -z $project ]] || where+=" AND project=$(q "$project")"
  if [[ -n $status ]]; then valid_status "$status"; where+=" AND status=$(q "$status")"; fi
  if ((json)); then
    sql -json "SELECT * FROM tasks WHERE $where ORDER BY project, id;" | jq -c '(. // [])[] | .deliverables |= fromjson'
  else
    sql -separator $'\t' "SELECT id, status, COALESCE(owner_agent,'-'), replace(title, char(10), ' ') FROM tasks WHERE $where ORDER BY project, id;"
  fi
}

# ---------- show ----------
cmd_show() {
  [[ $# -eq 1 ]] || usage "show <id>"
  valid_id "$1"
  local row sid act=""
  row=$(require_task "$1"); sid=$(jq -r '.session_id // empty' <<<"$row")
  if [[ -n $sid ]]; then   # 担当 agent の最終活動(tasks.session_id と agent_activity.session_id を結ぶ)
    act=$(sql -json "$(act_select 10) WHERE session_id=$(q "$sid");" | jq -c '.[0] // null')
  fi
  jq --argjson a "${act:-null}" '.deliverables |= fromjson | .activity = $a' <<<"$row"
}

# ---------- claim ----------
cmd_claim() {
  [[ $# -ge 1 ]] || usage "claim <id> --owner <name> [--session <sid>] [--account <acct>]"
  local id=$1 owner="" session="" account=""; shift
  valid_id "$id"
  while [[ $# -gt 0 ]]; do
    case $1 in
      --owner)   need_arg "$@"; owner=$2; shift 2;;
      --session) need_arg "$@"; session=$2; shift 2;;
      --account) need_arg "$@"; account=$2; shift 2;;
      *) usage "claim: 不明な引数 $1";;
    esac
  done
  blank "$owner" && usage "claim: --owner が必要です"
  require_task "$id" >/dev/null
  local changed
  changed=$(sql "UPDATE tasks SET status='in_progress', owner_agent=$(q "$owner"),
      session_id=COALESCE(NULLIF($(q "$session"),''), session_id),
      account=COALESCE(NULLIF($(q "$account"),''), account), updated_at=$(q "$(now)")
    WHERE id=$(q "$id") AND status='todo'; SELECT changes();")
  [[ $changed == 1 ]] || die "claim できません(status が todo ではない): $id"
  echo "$id claimed by $owner"
}

# ---------- update ----------
cmd_update() {
  [[ $# -ge 1 ]] || usage "update <id> [--status S] [--title T] [--owner N] [--session S] [--account A] [--parent ID]"
  local id=$1; shift
  valid_id "$id"
  local sets=() row cur
  while [[ $# -gt 0 ]]; do
    case $1 in
      --status)  need_arg "$@"; valid_status "$2"
                 [[ $2 != done ]] || usage "update: done にするには tb done を使う(deliverables と要約が必須)"
                 sets+=("status=$(q "$2")"); shift 2;;
      --title)   need_arg "$@"; blank "$2" && usage "update: title が空です"; sets+=("title=$(q "$2")"); shift 2;;
      --owner)   need_arg "$@"; sets+=("owner_agent=NULLIF($(q "$2"),'')"); shift 2;;
      --session) need_arg "$@"; sets+=("session_id=NULLIF($(q "$2"),'')"); shift 2;;
      --account) need_arg "$@"; sets+=("account=NULLIF($(q "$2"),'')"); shift 2;;
      --parent)  need_arg "$@"; valid_id "$2"; require_task "$2" >/dev/null
                 [[ $2 != "$id" ]] || usage "update: 自分自身を parent にできません"
                 sets+=("parent_id=$(q "$2")"); shift 2;;
      *) usage "update: 不明な引数 $1";;
    esac
  done
  [[ ${#sets[@]} -gt 0 ]] || usage "update: 変更する項目がありません"
  row=$(require_task "$id"); cur=$(jq -r .status <<<"$row")
  [[ $cur != done ]] || die "done のタスクは update できません: $id"
  local IFS=,
  sql "UPDATE tasks SET ${sets[*]}, updated_at=$(q "$(now)") WHERE id=$(q "$id");"
  echo "$id updated"
}

# ---------- done ----------
cmd_done() {
  [[ $# -ge 1 ]] || usage "done <id> -d <成果物パス> [-d ...] -m <要約>"
  local id=$1 summary="" dels=(); shift
  valid_id "$id"
  while [[ $# -gt 0 ]]; do
    case $1 in
      -d|--deliverable) need_arg "$@"; blank "$2" || dels+=("$2"); shift 2;;
      -m|--summary)     need_arg "$@"; summary=$2; shift 2;;
      *) usage "done: 不明な引数 $1";;
    esac
  done
  [[ ${#dels[@]} -gt 0 ]] || usage "done: 成果物(-d)が必須です"
  blank "$summary" && usage "done: 要約(-m)が必須です"
  local row cur dj
  row=$(require_task "$id"); cur=$(jq -r .status <<<"$row")
  [[ $cur != done ]] || die "すでに done です: $id"
  dj=$(jq -nc '$ARGS.positional' --args "${dels[@]}")
  sql "UPDATE tasks SET status='done', deliverables=$(q "$dj"), summary=$(q "$summary"),
         reported_at=NULL, updated_at=$(q "$(now)") WHERE id=$(q "$id");"
  echo "$id done (未報告。tb report $id を実行)"
}

# ---------- block ----------
cmd_block() {
  [[ $# -ge 1 ]] || usage "block <id> [-m <理由>]"
  local id=$1 reason=""; shift
  valid_id "$id"
  while [[ $# -gt 0 ]]; do
    case $1 in
      -m|--message) need_arg "$@"; reason=$2; shift 2;;
      *) usage "block: 不明な引数 $1";;
    esac
  done
  local row cur; row=$(require_task "$id"); cur=$(jq -r .status <<<"$row")
  [[ $cur != done ]] || die "done のタスクは block できません: $id"
  sql "UPDATE tasks SET status='blocked', note=NULLIF($(q "$reason"),''), updated_at=$(q "$(now)") WHERE id=$(q "$id");"
  echo "$id blocked"
}

# ---------- report ----------
# 宛先の状態を見て、idle/done のときだけ送る。0=送信済み 10=宛先が使用中 11=状態取得/送信の失敗
herdr_send() {  # $1=宛先 $2=本文 $3=ログ用 ID
  local target=$1 msg=$2 id=$3 st out
  st=$("$HERDR_BIN" agent get "$target" 2>/dev/null | jq -r '.result.agent.agent_status // empty' 2>/dev/null) || st=""
  case $st in
    idle|done) ;;
    "") echo "tb: 宛先 '$target' の状態を取得できません。未送信(pending に残す): $id" >&2; return 11;;
    *)  echo "tb: 宛先 '$target' が $st のため送りません。未送信(pending に残す): $id" >&2; return 10;;
  esac
  if ! out=$("$HERDR_BIN" agent prompt "$target" "$msg" 2>&1) || jq -e 'type=="object" and has("error")' <<<"$out" >/dev/null 2>&1; then
    echo "tb: 送信に失敗しました。未送信(pending に残す): $id" >&2
    echo "$out" >&2
    return 11
  fi
}

cmd_report() {
  [[ $# -eq 1 ]] || usage "report <id>"
  if [[ $1 =~ ^C-[0-9]+$ ]]; then deliver_comment "${1#C-}"; return $?; fi   # 未配送コメントの再送
  local id=$1; valid_id "$id"
  local row status project summary paths reported target msg
  row=$(require_task "$id")
  status=$(jq -r .status <<<"$row"); project=$(jq -r .project <<<"$row")
  summary=$(jq -r '.summary // ""' <<<"$row"); reported=$(jq -r '.reported_at // ""' <<<"$row")
  paths=$(jq -r '.deliverables | fromjson | join(", ")' <<<"$row")
  [[ $status == done ]] || die "done ではないタスクは report できません($status): $id"
  if [[ -n $reported ]]; then echo "$id は報告済みです($reported)"; return 0; fi

  target=$(target_for "$project")
  # prompt は 1 行にする(改行が入ると途中で submit されうる)
  summary=$(printf '%s' "$summary" | tr '\r\n\t' '   ' | tr -s ' ')
  summary=${summary%"${summary##*[![:space:]]}"}
  msg="[$id done] $summary / $paths"
  herdr_send "$target" "$msg" "$id" || return $?
  sql "UPDATE tasks SET reported_at=$(q "$(now)"), updated_at=$(q "$(now)") WHERE id=$(q "$id");"
  echo "$id reported to $target"
}

# ---------- pending ----------
cmd_pending() {
  local mode=tsv
  while [[ $# -gt 0 ]]; do
    case $1 in
      --json) mode=json; shift;;
      --ids)  mode=ids; shift;;
      *) usage "pending: 不明な引数 $1";;
    esac
  done
  local where="status='done' AND (reported_at IS NULL OR reported_at='')"
  case $mode in
    ids)  sql "SELECT id FROM tasks WHERE $where ORDER BY updated_at, id;"
          sql "SELECT 'C-'||id FROM comments WHERE delivered_at IS NULL ORDER BY id;";;
    json) sql -json "SELECT * FROM tasks WHERE $where ORDER BY updated_at, id;" | jq -c '(. // [])[] | .deliverables |= fromjson'
          sql -json "SELECT * FROM comments WHERE delivered_at IS NULL ORDER BY id;" | jq -c '(. // [])[] | .deliverables |= fromjson | .id = "C-\(.id)"';;
    tsv)  local id project summary
          while IFS=$'\t' read -r id project summary; do
            printf '%s\t%s\t%s\t%s\n' "$id" "$project" "$(target_for "$project")" "$summary"
          done < <(sql -separator $'\t' "SELECT id, project, replace(replace(COALESCE(summary,''), char(10), ' '), char(9), ' ') FROM tasks WHERE $where ORDER BY updated_at, id;")
          # 未配送のコメント: ID は C-<n>(tb report C-<n> で再送)
          while IFS=$'\t' read -r id project summary; do
            printf '%s\t%s\t%s\t%s\n' "$id" "$project" "$(target_for "$project")" "$summary"
          done < <(sql -separator $'\t' "SELECT 'C-'||c.id, COALESCE(t.project,''), '['||c.kind||'] '||substr(replace(replace(c.text, char(10), ' '), char(9), ' '),1,80)
            FROM comments c LEFT JOIN tasks t ON t.id=c.task_id WHERE c.delivered_at IS NULL ORDER BY c.id;");;
  esac
}

# ---------- 代行依頼(判定と記録だけ。cmd は実行しない) ----------
ALLOWLIST=${TB_ALLOWLIST:-$TB_ROOT/config/proxy-allowlist.txt}
EFFECTS="read-only write external"
valid_pid() { [[ $1 =~ ^[0-9]+$ ]] || usage "代行依頼の ID は数字: $1"; }
trim() { local s=$1; s=${s#"${s%%[![:space:]]*}"}; s=${s%"${s##*[![:space:]]}"}; printf '%s' "$s"; }

cmd_proxy-request() {
  [[ $# -ge 1 ]] || usage "proxy-request <task-id> --cmd C --why W --effect read-only|write|external [--expect E]"
  local tid=$1 c="" why="" effect="" expect=""; shift
  valid_id "$tid"
  while [[ $# -gt 0 ]]; do
    case $1 in
      --cmd)    need_arg "$@"; c=$2; shift 2;;
      --why)    need_arg "$@"; why=$2; shift 2;;
      --effect) need_arg "$@"; effect=$2; shift 2;;
      --expect) need_arg "$@"; expect=$2; shift 2;;
      *) usage "proxy-request: 不明な引数 $1";;
    esac
  done
  c=$(trim "$c")
  blank "$c" && usage "proxy-request: --cmd が必要です"
  blank "$why" && usage "proxy-request: --why が必要です"
  [[ -n $effect ]] || usage "proxy-request: --effect が必須です(read-only|write|external。迷ったら write)"
  [[ " $EFFECTS " == *" $effect "* ]] || usage "proxy-request: --effect は $EFFECTS のどれか: $effect"
  require_task "$tid" >/dev/null
  local prior status=open result="" n id; n=$(now)
  prior=$(sql "SELECT id FROM proxy_requests WHERE cmd=$(q "$c") AND status='denied' ORDER BY id LIMIT 1;")
  if [[ -n $prior ]]; then
    status=denied; result="同一 cmd が人に拒否済み(依頼 $prior)。同じ依頼は出し直さず、別の方法を提案すること"
  fi
  id=$(sql "INSERT INTO proxy_requests (task_id, cmd, why, effect, expect, status, result, created_at, updated_at)
            VALUES ($(q "$tid"), $(q "$c"), $(q "$why"), $(q "$effect"), NULLIF($(q "$expect"),''), $(q "$status"),
                    NULLIF($(q "$result"),''), $(q "$n"), $(q "$n")); SELECT last_insert_rowid();")
  [[ $status == denied ]] && echo "tb: $result" >&2
  echo "$id $status"
}

cmd_proxy-list() {
  local status="" json=0 where="1=1"
  while [[ $# -gt 0 ]]; do
    case $1 in
      --status) need_arg "$@"; status=$2; shift 2;;
      --json)   json=1; shift;;
      *) usage "proxy-list: 不明な引数 $1";;
    esac
  done
  if [[ -n $status ]]; then
    [[ $status =~ ^(open|done|pending-human|denied)$ ]] || usage "proxy-list: status は open|done|pending-human|denied: $status"
    where+=" AND status=$(q "$status")"
  fi
  if ((json)); then
    sql -json "SELECT * FROM proxy_requests WHERE $where ORDER BY id;" | jq -c '(. // [])[]'
  else
    sql -separator $'\t' "SELECT id, status, effect, task_id, replace(replace(cmd, char(10), ' '), char(9), ' ') FROM proxy_requests WHERE $where ORDER BY id;"
  fi
}

cmd_proxy-resolve() {
  [[ $# -ge 1 ]] || usage "proxy-resolve <id> --status done|pending-human|denied [--result <本文かファイルパス>]"
  local id=$1 status="" result=""; shift
  valid_pid "$id"
  while [[ $# -gt 0 ]]; do
    case $1 in
      --status) need_arg "$@"; status=$2; shift 2;;
      --result) need_arg "$@"; result=$2; shift 2;;
      *) usage "proxy-resolve: 不明な引数 $1";;
    esac
  done
  [[ $status =~ ^(done|pending-human|denied)$ ]] || usage "proxy-resolve: --status は done|pending-human|denied のどれか"
  local cur; cur=$(sql "SELECT status FROM proxy_requests WHERE id=$id;")
  [[ -n $cur ]] || die "代行依頼が見つかりません: $id"
  [[ $cur == open || $cur == pending-human ]] || die "解決済み($cur)の依頼は変更できません: $id"
  sql "UPDATE proxy_requests SET status=$(q "$status"), result=NULLIF($(q "$result"),''), updated_at=$(q "$(now)") WHERE id=$id;"
  echo "$id $status"
}

# cmd に含まれる「副作用・連鎖・展開」の兆候を META に入れる(クォート内でも拾う。安全側に倒す)
detect_meta() {
  local c=$1; META=()
  [[ $c == *'>'* ]] && META+=("リダイレクト(>)")
  [[ $c == *'<'* ]] && META+=("リダイレクト(<)")
  [[ $c == *'|'* ]] && META+=("パイプ/||")
  [[ $c == *';'* ]] && META+=("連結(;)")
  [[ $c == *'&'* ]] && META+=("連結/バックグラウンド(&, &&)")
  [[ $c == *'$'* ]] && META+=("展開(\$, \$())")
  [[ $c == *'`'* ]] && META+=("バッククォート")
  [[ $c == *$'\n'* || $c == *$'\r'* ]] && META+=("改行")
  grep -Eiq -- '(^|[[:space:]])(-X|--request|--method)[[:space:]=]*(POST|PUT|DELETE|PATCH)' <<<"$c" && META+=("書き込み系の HTTP メソッド")
  grep -Eq -- '(^|[[:space:]])--(approve|merge|body|add)' <<<"$c" && META+=("書き込み系のフラグ(--approve/--merge/--body/--add)")
  grep -Eq -- '(^|[[:space:]])--output' <<<"$c" && META+=("ファイル出力(--output)")
  return 0
}

cmd_proxy-check() {
  [[ $# -eq 1 ]] || usage "proxy-check <id>"
  valid_pid "$1"
  local row c effect status
  row=$(sql -json "SELECT * FROM proxy_requests WHERE id=$1;" | jq -c '.[0] // empty')
  [[ -n $row ]] || die "代行依頼が見つかりません: $1"
  c=$(jq -r .cmd <<<"$row"); effect=$(jq -r .effect <<<"$row"); status=$(jq -r .status <<<"$row")

  local reasons=() mismatch="" META=()
  detect_meta "$c"
  if [[ ${#META[@]} -gt 0 ]]; then
    local metas; metas=$(IFS=、; echo "${META[*]}")
    reasons+=("危険な構文を含む: $metas")
    [[ $effect == read-only ]] && mismatch="申告は read-only だが、コマンドに $metas を含む"
  fi
  [[ $status == denied ]] && reasons+=("すでに denied")
  [[ $effect != read-only ]] && reasons+=("申告 effect が $effect")

  # 許可リスト(先頭一致。語の境界で比較: "git log" は "git log -5" に一致、"git logx" には一致しない)
  local matched="" line
  if [[ -r $ALLOWLIST ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      line=$(trim "$line")
      [[ -z $line || $line == \#* ]] && continue
      if [[ $c == "$line" || $c == "$line "* || $c == "$line"$'\t'* ]]; then matched=$line; break; fi
    done <"$ALLOWLIST"
    [[ -n $matched ]] || reasons+=("許可リストにない")
  else
    reasons+=("許可リストを読めない($ALLOWLIST)。安全側で human")
  fi

  if [[ ${#reasons[@]} -eq 0 ]]; then
    echo allow
    echo "match: $matched"
  else
    echo human
    local r; for r in "${reasons[@]}"; do echo "reason: $r"; done
  fi
  [[ -z $mismatch ]] || echo "mismatch: $mismatch"
  return 0
}

# ---------- touch / activity(hook から呼ばれる。agent を止めないことが最優先) ----------
TOUCH_LOG=${TB_TOUCH_LOG:-$(dirname "$DB")/touch-errors.log}
ID_RE='^[A-Za-z0-9._:-]{1,128}$'

# act_select N: working 推定と、N 分以上の滞留(stuck)を付けた SELECT(WHERE は呼び出し側)
act_select() {
  [[ $1 =~ ^[0-9]+$ ]] || usage "分は数字: $1"
  local w="last_prompt_at IS NOT NULL AND (last_stop_at IS NULL OR last_prompt_at > last_stop_at)"
  echo "SELECT session_id, pane_id, tab_id, workspace_id, cwd, last_prompt_id, last_prompt_at, last_stop_at, updated_at,
    CASE WHEN $w THEN 1 ELSE 0 END AS working,
    CASE WHEN $w AND (julianday('now') - julianday(last_prompt_at)) * 1440 >= $1 THEN 1 ELSE 0 END AS stuck,
    CASE WHEN last_prompt_at IS NULL THEN NULL
         ELSE CAST((julianday('now') - julianday(last_prompt_at)) * 1440 AS INTEGER) END AS since_prompt_min
    FROM agent_activity"
}

# 失敗時は固定の理由コードだけを stdout に出して return 1。入力値・DB のエラー文は一切出さない
touch_impl() {
  local ev="" sid="" pane="" tab="" ws="" cwd="" pid=""
  while [[ $# -gt 0 ]]; do
    [[ $# -ge 2 ]] || { echo invalid-args; return 1; }
    case $1 in
      --event) ev=$2;; --session-id) sid=$2;; --pane-id) pane=$2;; --tab-id) tab=$2;;
      --workspace-id) ws=$2;; --cwd) cwd=$2;; --prompt-id) pid=$2;;
      *) echo invalid-args; return 1;;
    esac
    shift 2
  done
  [[ $ev == UserPromptSubmit || $ev == Stop ]] || { echo invalid-event; return 1; }
  [[ -n $sid ]] || { echo missing-session-id; return 1; }
  [[ $sid =~ $ID_RE ]] || { echo invalid-session-id; return 1; }
  local v
  for v in "$pane" "$tab" "$ws" "$pid"; do
    [[ -z $v || $v =~ $ID_RE ]] || { echo invalid-field; return 1; }
  done
  { [[ ${#cwd} -le 1024 ]] && [[ $cwd != *$'\n'* ]]; } || { echo invalid-cwd; return 1; }

  local ts="strftime('%Y-%m-%dT%H:%M:%fZ','now')" pa="NULL" sa="NULL" err
  if [[ $ev == UserPromptSubmit ]]; then pa=$ts; else sa=$ts; fi
  local SQL_TIMEOUT=1000   # ロックされていても 1 秒で諦める
  err=$({ init_db && sql "INSERT INTO agent_activity
      (session_id, pane_id, tab_id, workspace_id, cwd, last_prompt_id, last_prompt_at, last_stop_at, updated_at)
    VALUES ($(q "$sid"), NULLIF($(q "$pane"),''), NULLIF($(q "$tab"),''), NULLIF($(q "$ws"),''), NULLIF($(q "$cwd"),''),
            NULLIF($(q "$pid"),''), $pa, $sa, $ts)
    ON CONFLICT(session_id) DO UPDATE SET
      pane_id=COALESCE(excluded.pane_id, pane_id), tab_id=COALESCE(excluded.tab_id, tab_id),
      workspace_id=COALESCE(excluded.workspace_id, workspace_id), cwd=COALESCE(excluded.cwd, cwd),
      last_prompt_id=COALESCE(excluded.last_prompt_id, last_prompt_id),
      last_prompt_at=COALESCE(excluded.last_prompt_at, last_prompt_at),
      last_stop_at=COALESCE(excluded.last_stop_at, last_stop_at),
      updated_at=excluded.updated_at;"; } 2>&1) && return 0
  if grep -qiE 'locked|busy' <<<"$err"; then echo db-locked
  elif grep -qiE 'readonly|read-only|unable to open' <<<"$err"; then echo db-readonly
  else echo db-error; fi
  return 1
}

# 常に終了コード 0・標準出力/標準エラーなし。失敗は touch-errors.log に 1 行(時刻・event・理由コードのみ)
cmd_touch() {
  {
    local reason prev="" a ev="-"
    for a in "$@"; do
      [[ $prev == --event && ( $a == UserPromptSubmit || $a == Stop ) ]] && ev=$a
      prev=$a
    done
    if ! reason=$(touch_impl "$@" 2>/dev/null); then
      mkdir -p "$(dirname "$TOUCH_LOG")" 2>/dev/null || true
      printf '%s event=%s reason=%s\n' "$(now)" "$ev" "${reason:-unknown}" >>"$TOUCH_LOG" 2>/dev/null || true
    fi
  } >/dev/null 2>&1
  return 0
}

cmd_activity() {
  local json=0 stuck=10
  while [[ $# -gt 0 ]]; do
    case $1 in
      --json) json=1; shift;;
      --stuck-min) need_arg "$@"; stuck=$2; shift 2;;
      *) usage "activity: 不明な引数 $1";;
    esac
  done
  local s; s=$(act_select "$stuck")
  if ((json)); then
    sql -json "$s ORDER BY updated_at DESC;" | jq -c '(. // [])[]'
  else
    sql -nullvalue - -separator $'\t' "SELECT session_id, COALESCE(pane_id,'-'), working, stuck, last_prompt_at, last_stop_at, COALESCE(cwd,'-')
      FROM ($s) ORDER BY updated_at DESC;"
  fi
}

# ---------- comment / comments(worker → 指揮官の報告コメント) ----------
COMMENT_KINDS="done progress question blocked"
LABEL_NAME=""; LABEL_PANE=""; LABEL_SESSION=""

# 報告者ラベルは herdr から引く(自己申告にしない)。引けなければ 1 を返す(理由は stderr)
resolve_label() {
  local pane=${HERDR_PANE_ID:-} out row
  [[ -n $pane ]] || { echo "tb: HERDR_PANE_ID がありません。報告者を特定できないため保存しません" >&2; return 1; }
  out=$("$HERDR_BIN" agent list 2>/dev/null) || { echo "tb: herdr agent list に失敗。報告者を特定できないため保存しません" >&2; return 1; }
  row=$(jq -c --arg p "$pane" '[.result.agents[]? | select(.pane_id==$p)][0] // empty' <<<"$out" 2>/dev/null) || row=""
  [[ -n $row ]] || { echo "tb: pane $pane に該当する agent がありません。保存しません" >&2; return 1; }
  LABEL_NAME=$(jq -r '.name // ""' <<<"$row"); LABEL_SESSION=$(jq -r '.agent_session.value // ""' <<<"$row"); LABEL_PANE=$pane
  [[ -n $LABEL_NAME ]] || { echo "tb: pane $pane の agent に名前がありません(herdr agent rename)。保存しません" >&2; return 1; }
  [[ -n $LABEL_SESSION ]] || { echo "tb: pane $pane の agent に session がありません。保存しません" >&2; return 1; }
  [[ $LABEL_NAME =~ ^[A-Za-z0-9._-]{1,64}$ && $LABEL_PANE =~ ^[A-Za-z0-9._:-]{1,64}$ ]] \
    || { echo "tb: 報告者名/pane に使えない文字があります。保存しません" >&2; return 1; }
}

# 1 行化 + ラベル偽装の無効化 + 先頭 N 字
oneline() {  # $1=本文 $2=最大字数
  printf '%s' "$1" | tr '\r\n\t' '   ' | tr -d '\000-\010\013\014\016-\037' | tr -s ' ' \
    | jq -Rrs --argjson n "$2" 'gsub("\\[\\s*from\\s*[:：]";"(from:";"i") | gsub("^\\s+|\\s+$";"") | .[0:$n]'
}

deliver_comment() {  # $1=comments.id → 0 送信済み / 10 / 11
  local cid=$1 row delivered tid kind text name pane project target msg
  [[ $cid =~ ^[0-9]+$ ]] || usage "コメント ID は C-<数字>"
  row=$(sql -json "SELECT * FROM comments WHERE id=$cid;" | jq -c '.[0] // empty')
  [[ -n $row ]] || die "コメントが見つかりません: C-$cid"
  delivered=$(jq -r '.delivered_at // ""' <<<"$row")
  if [[ -n $delivered ]]; then echo "C-$cid は配送済みです($delivered)"; return 0; fi
  tid=$(jq -r .task_id <<<"$row"); kind=$(jq -r .kind <<<"$row"); text=$(jq -r .text <<<"$row")
  name=$(jq -r .from_name <<<"$row"); pane=$(jq -r .from_pane <<<"$row")
  project=$(sql "SELECT project FROM tasks WHERE id=$(q "$tid");"); target=$(target_for "$project")
  msg="[from: $name / $pane / $tid / $kind] $(oneline "$text" 200) (詳細: tb comments $tid)"
  herdr_send "$target" "$msg" "C-$cid" || return $?
  sql "UPDATE comments SET delivered_at=$(q "$(now)") WHERE id=$cid;"
  echo "C-$cid delivered to $target"
}

# 終了コード: 0 配送済み / 10 保存済み・宛先使用中で未配送 / 11 保存済み・送信失敗 / 3 報告者を特定できず未保存 / 2 使い方 / 1 その他
cmd_comment() {
  [[ $# -ge 1 ]] || usage "comment <task-id> --kind done|progress|question|blocked --text T [--deliverables a,b] [--json]"
  local tid=$1 kind="" text="" dels="" json=0; shift
  valid_id "$tid"
  while [[ $# -gt 0 ]]; do
    case $1 in
      --kind) need_arg "$@"; kind=$2; shift 2;;
      --text) need_arg "$@"; text=$2; shift 2;;
      --deliverables) need_arg "$@"; dels=$2; shift 2;;
      --json) json=1; shift;;
      --from|--from-*|--name|--pane|--session) usage "comment: 報告者は herdr から自動で決まります。$1 は指定できません";;
      *) usage "comment: 不明な引数 $1";;
    esac
  done
  [[ " $COMMENT_KINDS " == *" $kind "* ]] || usage "comment: --kind は $COMMENT_KINDS のどれか"
  blank "$text" && usage "comment: --text が必要です"
  local darr="[]"
  if [[ -n $dels ]]; then
    darr=$(jq -nc --arg d "$dels" '$d | split(",") | map(gsub("^\\s+|\\s+$";"")) | map(select(length>0))')
  fi
  if [[ $kind == done && $darr == "[]" ]]; then usage "comment: done は --deliverables(成果物)が必須です"; fi
  require_task "$tid" >/dev/null
  resolve_label || return 3
  local cid rc=0
  cid=$(sql "INSERT INTO comments (task_id, kind, text, deliverables, from_name, from_pane, from_session, created_at)
    VALUES ($(q "$tid"), $(q "$kind"), $(q "$text"), $(q "$darr"), $(q "$LABEL_NAME"), $(q "$LABEL_PANE"), $(q "$LABEL_SESSION"), $(q "$(now)"));
    SELECT last_insert_rowid();")
  deliver_comment "$cid" >/dev/null || rc=$?   # 保存は済んでいる。配送の結果は終了コードで返す
  if ((json)); then sql -json "SELECT * FROM comments WHERE id=$cid;" | jq -c '.[0] | .deliverables |= fromjson | .id = "C-\(.id)"'
  else echo "C-$cid $([[ $rc == 0 ]] && echo delivered || echo saved-undelivered)"; fi
  return $rc
}

cmd_comments() {
  local tid="" kind="" und=0 open=0 json=0 where="1=1"
  if [[ ${1:-} == T-* ]]; then tid=$1; shift; valid_id "$tid"; fi
  while [[ $# -gt 0 ]]; do
    case $1 in
      --kind) need_arg "$@"; kind=$2; shift 2;;
      --undelivered) und=1; shift;;
      --open) open=1; shift;;
      --json) json=1; shift;;
      *) usage "comments: 不明な引数 $1";;
    esac
  done
  [[ -z $tid ]] || where+=" AND task_id=$(q "$tid")"
  if [[ -n $kind ]]; then [[ " $COMMENT_KINDS " == *" $kind "* ]] || usage "comments: --kind は $COMMENT_KINDS"; where+=" AND kind=$(q "$kind")"; fi
  ((und)) && where+=" AND delivered_at IS NULL"
  ((open)) && where+=" AND kind IN ('question','blocked') AND resolved_at IS NULL"   # 承認待ち
  if ((json)); then
    sql -json "SELECT * FROM comments WHERE $where ORDER BY id;" | jq -c '(. // [])[] | .deliverables |= fromjson | .id = "C-\(.id)"'
  else
    # needs_human: question/blocked は人の判断・承認待ち
    sql -separator $'\t' "SELECT 'C-'||id, kind, CASE WHEN kind IN ('question','blocked') AND resolved_at IS NULL THEN 'needs-human'
           WHEN resolved_at IS NOT NULL THEN 'resolved' ELSE '-' END,
      CASE WHEN delivered_at IS NULL THEN 'undelivered' ELSE 'delivered' END, task_id, from_name,
      replace(replace(text, char(10), ' '), char(9), ' ') FROM comments WHERE $where ORDER BY id;"
  fi
}

# 人だけが畳める。HERDR_PANE_ID が報告者として登録済みの agent(名前または session が comments.from_* にある)なら拒否。
# HERDR_PANE_ID がない端末、または agent ではない pane(人のシェル)は許可。pane が設定されているのに確認できないときは安全側で拒否
deny_if_worker() {
  local pane=${HERDR_PANE_ID:-} out row name sid hit
  [[ -n $pane ]] || return 0
  out=$("$HERDR_BIN" agent list 2>/dev/null) || { echo "tb: herdr agent list に失敗。worker でないことを確認できないため resolve しません" >&2; return 1; }
  row=$(jq -c --arg p "$pane" '[.result.agents[]? | select(.pane_id==$p)][0] // empty' <<<"$out" 2>/dev/null) || { echo "tb: herdr の応答を読めません。resolve しません" >&2; return 1; }
  [[ -n $row ]] || return 0
  name=$(jq -r '.name // ""' <<<"$row"); sid=$(jq -r '.agent_session.value // ""' <<<"$row")
  hit=$(sql "SELECT count(*) FROM comments WHERE (from_name<>'' AND from_name=$(q "$name")) OR (from_session<>'' AND from_session=$(q "$sid"));")
  if [[ $hit != 0 ]]; then
    echo "tb: resolve は人の操作です。報告者として登録された agent(${name:-?} / $pane)の pane からは実行できません" >&2
    return 1
  fi
}

# 終了コード: 0 成功/すでに済み / 1 拒否・存在しない・対象外 / 2 使い方
cmd_resolve() {
  [[ $# -ge 1 ]] || usage "resolve <C-n|n> [-m <メモ>]"
  local ref=${1#C-} note=""; shift
  [[ $ref =~ ^[0-9]+$ ]] || usage "resolve: ID は C-<数字> か数字: $ref"
  while [[ $# -gt 0 ]]; do
    case $1 in
      -m|--message) need_arg "$@"; note=$2; shift 2;;
      *) usage "resolve: 不明な引数 $1";;
    esac
  done
  deny_if_worker || return 1
  local row kind at
  row=$(sql -json "SELECT kind, resolved_at FROM comments WHERE id=$ref;" | jq -c '.[0] // empty')
  [[ -n $row ]] || die "報告が見つかりません: C-$ref"
  kind=$(jq -r .kind <<<"$row"); at=$(jq -r '.resolved_at // ""' <<<"$row")
  [[ $kind == question || $kind == blocked ]] || die "resolve できるのは question / blocked だけです(C-$ref は $kind)"
  if [[ -n $at ]]; then echo "C-$ref はすでに対応済みです($at)"; return 0; fi
  sql "UPDATE comments SET resolved_at=$(q "$(now)"), resolved_note=NULLIF($(q "$note"),'') WHERE id=$ref AND resolved_at IS NULL;"
  echo "C-$ref resolved"
}

cmd_help() {
  cat <<'USAGE'
tb add -p <project> -t <title> [--parent ID] [--owner N] [--session S] [--account A]   → ID を表示
tb list [-p project] [-s status] [--json]
tb show <id>
tb claim <id> --owner <name> [--session S] [--account A]    todo → in_progress(todo 以外は失敗)
tb update <id> [--status todo|in_progress|review|blocked] [--title T] [--owner N] [--session S] [--account A] [--parent ID]
tb done <id> -d <成果物> [-d ...] -m <要約>                  成果物と要約が必須。reported_at は空のまま
tb block <id> [-m <理由>]
tb report <id>      指示役へ [T-xxx done] ... を送る。成功時のみ reported_at を埋める
                    終了コード 0=送信済み/報告済み 10=宛先が使用中で未送信 11=送信/状態取得に失敗
tb pending [--json|--ids]   done なのに未報告のタスク

代行依頼(判定と記録だけ。cmd は tb が実行しない):
tb proxy-request <task-id> --cmd C --why W --effect read-only|write|external [--expect E]   → "<id> <status>"
tb proxy-list [--status open|done|pending-human|denied] [--json]
tb proxy-resolve <id> --status done|pending-human|denied [--result <本文かファイルパス>]
tb proxy-check <id>   1 行目が allow(自動代行可)か human(人に回す)。mismatch: があれば申告の食い違い

agent の活動記録(hook から。bin/tb-hook 経由が基本):
tb touch --event UserPromptSubmit|Stop --session-id S [--pane-id P] [--tab-id T] [--workspace-id W] [--cwd D] [--prompt-id I]
         常に終了コード 0・出力なし。失敗は data/touch-errors.log に 1 行(理由コードのみ)
tb activity [--json] [--stuck-min N]   最終入力・最終停止・working 推定・滞留(既定 10 分)

報告コメント(worker → 指揮官。報告者は HERDR_PANE_ID と herdr agent list から決まり、上書きできない):
tb comment <task-id> --kind done|progress|question|blocked --text T [--deliverables a,b] [--json]
         保存してから送る。終了コード 0=配送済み 10=保存済み・宛先使用中 11=保存済み・送信失敗 3=報告者を特定できず未保存
tb comments [<task-id>] [--kind K] [--undelivered] [--open] [--json]   --open: 未 resolved の question/blocked(承認待ち)
         未配送は tb pending に C-<n> として出る。tb report C-<n> で再送
tb resolve <C-n|n> [-m メモ]   question/blocked を対応済みにする(人の操作。報告者の agent の pane からは拒否)
USAGE
}

main() {
  local cmd=${1:-help}; shift || true
  case $cmd in
    help|-h|--help) cmd_help; return 0;;
    touch) cmd_touch "$@"; return 0;;   # 常に 0。ツールの有無チェックや init_db の失敗でも止めない
    add|list|show|claim|update|done|block|report|pending|activity) ;;
    proxy-request|proxy-list|proxy-resolve|proxy-check|comment|comments|resolve) ;;
    *) usage "不明なコマンド: $cmd";;
  esac
  need_tools
  init_db
  "cmd_$cmd" "$@"
}
main "$@"
