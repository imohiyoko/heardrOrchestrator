#!/usr/bin/env bash
# tb — herdr agent 用の最小タスク表(SQLite 1 ファイル)
# usage: tb <コマンド> ...  (tb help で一覧。各コマンドは taskboard/lib/*.sh の cmd_<名前>)
#
# 環境変数: TB_DB(DB パス) / TB_CONFIG(projects.conf) / HERDR_BIN(herdr の実体。テストでは疑似 herdr)
# 終了コード: 0 成功 / 1 エラー / 2 使い方の誤り
#             report のみ: 10 宛先が使用中などで未送信(pending に残る) / 11 送信・状態取得に失敗(pending に残る)
set -euo pipefail

# PATH に symlink で置かれても本体の場所を lib/ の起点にする
_src=${BASH_SOURCE[0]}
while [[ -L $_src ]]; do _d=$(cd "$(dirname "$_src")" && pwd); _src=$(readlink "$_src"); [[ $_src == /* ]] || _src=$_d/$_src; done
TB_ROOT=$(cd "$(dirname "$_src")/.." && pwd)
unset _src _d
# shellcheck source=../../lib/herdr-env.sh
source "$TB_ROOT/../lib/herdr-env.sh"
DB=${TB_DB:-$HERDR_DEFAULT_TB_DB}
CONF=${TB_CONFIG:-$TB_ROOT/config/projects.conf}
HERDR_BIN=${HERDR_BIN:-$HERDR_DEFAULT_BIN}

# 機能ごとのファイルは taskboard/lib/。読み込む順に意味があるのは db → core → transport だけ
for _m in db core transport tasks proxy activity comments digest send roles approvals alerts review agents; do
  # shellcheck source=/dev/null
  source "$TB_ROOT/lib/$_m.sh"
done
unset _m

cmd_help() { cat "$TB_ROOT/lib/help.txt"; }

main() {
  local cmd=${1:-help}; shift || true
  case $cmd in
    help|-h|--help) cmd_help; return 0;;
    touch) cmd_touch "$@"; return 0;;   # 常に 0。ツールの有無チェックや init_db の失敗でも止めない
    role-context) ( need_tools && init_db ) >/dev/null 2>&1 && cmd_role-context "$@" 2>/dev/null; return 0;;   # hook 用。常に 0
  esac
  # コマンド = lib/*.sh で定義された cmd_<名前>。一覧を別に持たない
  [[ $cmd =~ ^[a-z][a-z-]*$ ]] && declare -F "cmd_$cmd" >/dev/null || usage "不明なコマンド: $cmd"
  need_tools
  init_db || die "DB を開けないか、スキーマの移行に失敗しました: $DB"
  "cmd_$cmd" "$@"
}
main "$@"
