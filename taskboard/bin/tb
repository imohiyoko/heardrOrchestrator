#!/usr/bin/env bash
# tb — herdr agent 用の最小タスク表(SQLite 1 ファイル)
# usage: tb {add|list|show|claim|update|done|block|report|pending|proxy-*|touch|activity|comment|comments|digest|digests|send|flush|outbox|role-*|roles|approval|allow|ask|approve|reject|alert*|system-send} ...  (tb help で詳細)
#
# 環境変数: TB_DB(DB パス) / TB_CONFIG(projects.conf) / HERDR_BIN(herdr の実体。テストでは疑似 herdr)
# 終了コード: 0 成功 / 1 エラー / 2 使い方の誤り
#             report のみ: 10 宛先が使用中などで未送信(pending に残る) / 11 送信・状態取得に失敗(pending に残る)
set -euo pipefail

TB_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
DB=${TB_DB:-$TB_ROOT/data/tasks.db}
CONF=${TB_CONFIG:-$TB_ROOT/config/projects.conf}
HERDR_BIN=${HERDR_BIN:-herdr}
DEFAULT_TARGET=conductor
STATUSES="todo in_progress review done blocked"

die()   { echo "tb: $*" >&2; exit 1; }
usage() { echo "tb: $*" >&2; echo "(tb help で使い方)" >&2; exit 2; }

need_tools() {
  command -v sqlite3 >/dev/null || die "sqlite3 が必要です"
  command -v jq >/dev/null || die "jq が必要です"
}

sql() { sqlite3 -bail -batch -cmd ".timeout ${SQL_TIMEOUT:-5000}" "$DB" "$@"; }
q()   { local s=${1//\'/\'\'}; printf "'%s'" "$s"; }          # SQL 文字列リテラル化
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# tb send(指揮官 → worker)の送信箱。拒否したものも残す。migrate_db でも使う
OUTBOX_COLS="         -- tb send(指揮官 → worker)。拒否したものも残す
    id           INTEGER PRIMARY KEY AUTOINCREMENT,
    from_name    TEXT NOT NULL,                 -- herdr agent list から引いた値(自己申告ではない)
    from_pane    TEXT NOT NULL,
    from_session TEXT NOT NULL,
    target       TEXT NOT NULL,
    kind         TEXT NOT NULL CHECK (kind IN ('task','info','answer')),
    task_id      TEXT,
    text         TEXT NOT NULL,
    status       TEXT NOT NULL CHECK (status IN ('pending','queued','sent','denied')),   -- pending = 人の承認待ち
    reason       TEXT,                          -- 許可・拒否の根拠(routes.conf の行など)
    sent_at      TEXT,
    created_at   TEXT NOT NULL
  "

init_db() {
  mkdir -p "$(dirname "$DB")"
  sql "CREATE TABLE IF NOT EXISTS tasks (
    id           TEXT PRIMARY KEY,
    project      TEXT NOT NULL,
    title        TEXT NOT NULL,
    owner_agent  TEXT,
    session_id   TEXT,
    account      TEXT,
    status       TEXT NOT NULL DEFAULT 'todo'
                 CHECK (status IN ('todo','in_progress','review','done','blocked')),
    parent_id    TEXT,
    deliverables TEXT NOT NULL DEFAULT '[]',   -- JSON 配列
    summary      TEXT,                          -- done 時の要約
    note         TEXT,                          -- block 理由など
    reported_at  TEXT,                          -- report 成功時のみ埋まる
    created_at   TEXT NOT NULL,
    updated_at   TEXT NOT NULL
  );
  CREATE INDEX IF NOT EXISTS tasks_project_status ON tasks(project, status);
  CREATE TABLE IF NOT EXISTS proxy_requests (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    task_id    TEXT NOT NULL,
    cmd        TEXT NOT NULL,
    why        TEXT NOT NULL,
    effect     TEXT NOT NULL CHECK (effect IN ('read-only','write','external')),
    expect     TEXT,
    status     TEXT NOT NULL DEFAULT 'open'
               CHECK (status IN ('open','done','pending-human','denied')),
    result     TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
  );
  CREATE INDEX IF NOT EXISTS proxy_requests_status ON proxy_requests(status);
  CREATE TABLE IF NOT EXISTS comments (
    id           INTEGER PRIMARY KEY AUTOINCREMENT,
    task_id      TEXT NOT NULL,
    kind         TEXT NOT NULL CHECK (kind IN ('done','progress','question','blocked')),
    text         TEXT NOT NULL,
    deliverables TEXT NOT NULL DEFAULT '[]',   -- JSON 配列(done で必須)
    from_name    TEXT NOT NULL,                 -- herdr agent list から引いた値(自己申告ではない)
    from_pane    TEXT NOT NULL,
    from_session TEXT NOT NULL,
    delivered_at TEXT,                          -- 宛先へ送れたときだけ埋まる
    created_at   TEXT NOT NULL
  );
  CREATE INDEX IF NOT EXISTS comments_task ON comments(task_id);
  CREATE TABLE IF NOT EXISTS agent_activity (
    session_id     TEXT PRIMARY KEY,
    pane_id        TEXT,
    tab_id         TEXT,
    workspace_id   TEXT,
    cwd            TEXT,
    last_prompt_id TEXT,
    last_prompt_at TEXT,    -- UserPromptSubmit の時刻(UTC, ミリ秒)
    last_stop_at   TEXT,    -- Stop の時刻
    updated_at     TEXT NOT NULL
  );
  CREATE TABLE IF NOT EXISTS messages (       -- tb が送ろうとしたものすべて(送れたか否かも)
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    kind       TEXT NOT NULL,                  -- report|comment|digest|send|role|alert|scheduler
    ref        TEXT,                           -- T-.. / C-.. / D-..
    target     TEXT NOT NULL,
    body       TEXT NOT NULL,
    result     TEXT NOT NULL CHECK (result IN ('sent','busy','failed')),
    created_at TEXT NOT NULL
  );
  CREATE TABLE IF NOT EXISTS outbox ($OUTBOX_COLS);
  CREATE INDEX IF NOT EXISTS outbox_status ON outbox(status);
  CREATE TABLE IF NOT EXISTS approval_changes ( -- tb allow / tb ask の履歴(人が実行したもの)
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    pattern    TEXT NOT NULL,
    value      TEXT NOT NULL CHECK (value IN ('ask','allow')),
    created_at TEXT NOT NULL
  );
  CREATE TABLE IF NOT EXISTS role_briefings ( -- 役割をいつ誰(どのセッション)にどの版で渡したか
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    session_id TEXT NOT NULL,
    agent      TEXT NOT NULL,
    role_file  TEXT,                           -- roles/ からの相対パス(共通のみなら NULL)
    hash       TEXT NOT NULL,                  -- 渡した内容(_common + 役割)の SHA-256
    source     TEXT NOT NULL,                  -- startup|resume|clear|compact|broadcast
    via        TEXT NOT NULL CHECK (via IN ('hook','broadcast')),
    created_at TEXT NOT NULL
  );
  CREATE INDEX IF NOT EXISTS role_briefings_session ON role_briefings(session_id);
  CREATE TABLE IF NOT EXISTS alerts (         -- 見張り役が登録した異常と、その解析
    id            INTEGER PRIMARY KEY AUTOINCREMENT,
    fingerprint   TEXT NOT NULL,                -- --key(無ければ題名)の SHA-256 先頭。未解決の同じ指紋はまとめる
    severity      TEXT CHECK (severity IS NULL OR severity IN ('critical','high','medium','low')),   -- 解析役が決める
    title         TEXT NOT NULL,
    body          TEXT,
    source        TEXT NOT NULL,                -- 報告した agent 名(herdr から)か cli
    source_pane   TEXT,
    status        TEXT NOT NULL CHECK (status IN ('new','awaiting-approval','approved','queued','analyzing','analyzed','closed')),
    count         INTEGER NOT NULL DEFAULT 1,
    analyst       TEXT,
    note          TEXT,
    result_summary TEXT, result_report TEXT, result_path TEXT, result_by TEXT, result_delivered_at TEXT,
    first_seen TEXT NOT NULL, last_seen TEXT NOT NULL, analysis_started_at TEXT, analyzed_at TEXT, closed_at TEXT
  );
  CREATE INDEX IF NOT EXISTS alerts_status ON alerts(status);
  CREATE TABLE IF NOT EXISTS digests (        -- まとめ送信 1 通ごと。body は複数行の全文
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    target     TEXT NOT NULL,
    item_count INTEGER NOT NULL,
    body       TEXT NOT NULL,
    created_at TEXT NOT NULL
  );
  CREATE TABLE IF NOT EXISTS observations (   -- tb が観測して送った事象(同じものを二度送らない)
    key        TEXT PRIMARY KEY,
    kind       TEXT NOT NULL,                  -- idle|stuck|blocked
    task_id    TEXT,
    text       TEXT NOT NULL,
    digest_id  INTEGER,
    created_at TEXT NOT NULL
  );" >/dev/null
}

# 古い outbox(pending を持たない CHECK)を作り直す
migrate_db() {
  local def; def=$(sql "SELECT sql FROM sqlite_master WHERE type='table' AND name='outbox';")
  [[ -z $def || $def == *"'pending'"* ]] && return 0
  sql "BEGIN; CREATE TABLE outbox_new ($OUTBOX_COLS); INSERT INTO outbox_new SELECT * FROM outbox; DROP TABLE outbox; ALTER TABLE outbox_new RENAME TO outbox;
       CREATE INDEX IF NOT EXISTS outbox_status ON outbox(status); COMMIT;" >/dev/null
}

valid_id()      { [[ $1 =~ ^T-[A-Za-z0-9_]+-[0-9]{3,}$ ]] || usage "タスク ID は T-<project>-NNN 形式: $1"; }
valid_project() { [[ $1 =~ ^[A-Za-z0-9_]+$ ]] || usage "project は英数字と _ のみ: $1"; }
valid_status()  { [[ " $STATUSES " == *" $1 "* ]] || usage "status は $STATUSES のどれか: $1"; }
need_arg()      { [[ $# -ge 2 ]] || usage "$1 に値が必要です"; }
blank()         { [[ -z "${1//[[:space:]]/}" ]]; }

task_row() {  # $1=id → JSON 1 行(なければ空)
  sql -json "SELECT * FROM tasks WHERE id=$(q "$1");" | jq -c '.[0] // empty'
}
require_task() { local r; r=$(task_row "$1"); [[ -n $r ]] || die "タスクが見つかりません: $1"; printf '%s' "$r"; }

target_for() {  # $1=project → 指示役の名前
  local t=$DEFAULT_TARGET k v
  if [[ -f $CONF ]]; then
    while IFS='=' read -r k v || [[ -n $k ]]; do
      k=${k//[[:space:]]/}; v=${v//[[:space:]]/}
      [[ -z $k || $k == \#* ]] && continue
      [[ $k == "$1" && -n $v ]] && t=$v
    done <"$CONF"
  fi
  printf '%s' "$t"
}

# ---------- add ----------
cmd_add() {
  local project="" title="" parent="" owner="" session="" account=""
  while [[ $# -gt 0 ]]; do
    case $1 in
      -p|--project) need_arg "$@"; project=$2; shift 2;;
      -t|--title)   need_arg "$@"; title=$2; shift 2;;
      --parent)     need_arg "$@"; parent=$2; shift 2;;
      --owner)      need_arg "$@"; owner=$2; shift 2;;
      --session)    need_arg "$@"; session=$2; shift 2;;
      --account)    need_arg "$@"; account=$2; shift 2;;
      *) usage "add: 不明な引数 $1";;
    esac
  done
  [[ -n $project ]] || usage "add: -p <project> が必要です"
  valid_project "$project"
  blank "$title" && usage "add: -t <title> が必要です"
  if [[ -n $parent ]]; then valid_id "$parent"; require_task "$parent" >/dev/null; fi
  local n=$(now) p; p=$(q "$project")
  # 採番と挿入を 1 文で行い、同時 add でも重複しないようにする
  sql "INSERT INTO tasks (id, project, title, owner_agent, session_id, account, parent_id, created_at, updated_at)
       SELECT 'T-'||$p||'-'||printf('%03d', COALESCE(MAX(CAST(substr(id, length($p)+4) AS INTEGER)),0)+1),
              $p, $(q "$title"), NULLIF($(q "$owner"),''), NULLIF($(q "$session"),''), NULLIF($(q "$account"),''),
              NULLIF($(q "$parent"),''), $(q "$n"), $(q "$n")
       FROM tasks WHERE project=$p;
       SELECT id FROM tasks WHERE rowid=last_insert_rowid();"
}

# ---------- list ----------
cmd_list() {
  local project="" status="" json=0 where="1=1"
  while [[ $# -gt 0 ]]; do
    case $1 in
      -p|--project) need_arg "$@"; project=$2; shift 2;;
      -s|--status)  need_arg "$@"; status=$2; shift 2;;
      --json)       json=1; shift;;
      *) usage "list: 不明な引数 $1";;
    esac
  done
  [[ -z $project ]] || where+=" AND project=$(q "$project")"
  if [[ -n $status ]]; then valid_status "$status"; where+=" AND status=$(q "$status")"; fi
  if ((json)); then
    sql -json "SELECT * FROM tasks WHERE $where ORDER BY project, id;" | jq -c '(. // [])[] | .deliverables |= fromjson'
  else
    sql -separator $'\t' "SELECT id, status, COALESCE(owner_agent,'-'), replace(title, char(10), ' ') FROM tasks WHERE $where ORDER BY project, id;"
  fi
}

# ---------- show ----------
cmd_show() {
  [[ $# -eq 1 ]] || usage "show <id>"
  valid_id "$1"
  local row sid act=""
  row=$(require_task "$1"); sid=$(jq -r '.session_id // empty' <<<"$row")
  if [[ -n $sid ]]; then   # 担当 agent の最終活動(tasks.session_id と agent_activity.session_id を結ぶ)
    act=$(sql -json "$(act_select 10) WHERE session_id=$(q "$sid");" | jq -c '.[0] // null')
  fi
  jq --argjson a "${act:-null}" '.deliverables |= fromjson | .activity = $a' <<<"$row"
}

# ---------- claim ----------
cmd_claim() {
  [[ $# -ge 1 ]] || usage "claim <id> --owner <name> [--session <sid>] [--account <acct>]"
  local id=$1 owner="" session="" account=""; shift
  valid_id "$id"
  while [[ $# -gt 0 ]]; do
    case $1 in
      --owner)   need_arg "$@"; owner=$2; shift 2;;
      --session) need_arg "$@"; session=$2; shift 2;;
      --account) need_arg "$@"; account=$2; shift 2;;
      *) usage "claim: 不明な引数 $1";;
    esac
  done
  blank "$owner" && usage "claim: --owner が必要です"
  require_task "$id" >/dev/null
  local changed
  changed=$(sql "UPDATE tasks SET status='in_progress', owner_agent=$(q "$owner"),
      session_id=COALESCE(NULLIF($(q "$session"),''), session_id),
      account=COALESCE(NULLIF($(q "$account"),''), account), updated_at=$(q "$(now)")
    WHERE id=$(q "$id") AND status='todo'; SELECT changes();")
  [[ $changed == 1 ]] || die "claim できません(status が todo ではない): $id"
  echo "$id claimed by $owner"
}

# ---------- update ----------
cmd_update() {
  [[ $# -ge 1 ]] || usage "update <id> [--status S] [--title T] [--owner N] [--session S] [--account A] [--parent ID]"
  local id=$1; shift
  valid_id "$id"
  local sets=() row cur
  while [[ $# -gt 0 ]]; do
    case $1 in
      --status)  need_arg "$@"; valid_status "$2"
                 [[ $2 != done ]] || usage "update: done にするには tb done を使う(deliverables と要約が必須)"
                 sets+=("status=$(q "$2")"); shift 2;;
      --title)   need_arg "$@"; blank "$2" && usage "update: title が空です"; sets+=("title=$(q "$2")"); shift 2;;
      --owner)   need_arg "$@"; sets+=("owner_agent=NULLIF($(q "$2"),'')"); shift 2;;
      --session) need_arg "$@"; sets+=("session_id=NULLIF($(q "$2"),'')"); shift 2;;
      --account) need_arg "$@"; sets+=("account=NULLIF($(q "$2"),'')"); shift 2;;
      --parent)  need_arg "$@"; valid_id "$2"; require_task "$2" >/dev/null
                 [[ $2 != "$id" ]] || usage "update: 自分自身を parent にできません"
                 sets+=("parent_id=$(q "$2")"); shift 2;;
      *) usage "update: 不明な引数 $1";;
    esac
  done
  [[ ${#sets[@]} -gt 0 ]] || usage "update: 変更する項目がありません"
  row=$(require_task "$id"); cur=$(jq -r .status <<<"$row")
  [[ $cur != done ]] || die "done のタスクは update できません: $id"
  local IFS=,
  sql "UPDATE tasks SET ${sets[*]}, updated_at=$(q "$(now)") WHERE id=$(q "$id");"
  echo "$id updated"
}

# ---------- done ----------
cmd_done() {
  [[ $# -ge 1 ]] || usage "done <id> -d <成果物パス> [-d ...] -m <要約>"
  local id=$1 summary="" dels=(); shift
  valid_id "$id"
  while [[ $# -gt 0 ]]; do
    case $1 in
      -d|--deliverable) need_arg "$@"; blank "$2" || dels+=("$2"); shift 2;;
      -m|--summary)     need_arg "$@"; summary=$2; shift 2;;
      *) usage "done: 不明な引数 $1";;
    esac
  done
  [[ ${#dels[@]} -gt 0 ]] || usage "done: 成果物(-d)が必須です"
  blank "$summary" && usage "done: 要約(-m)が必須です"
  local row cur dj
  row=$(require_task "$id"); cur=$(jq -r .status <<<"$row")
  [[ $cur != done ]] || die "すでに done です: $id"
  dj=$(jq -nc '$ARGS.positional' --args "${dels[@]}")
  sql "UPDATE tasks SET status='done', deliverables=$(q "$dj"), summary=$(q "$summary"),
         reported_at=NULL, updated_at=$(q "$(now)") WHERE id=$(q "$id");"
  echo "$id done (未報告。tb report $id を実行)"
}

# ---------- block ----------
cmd_block() {
  [[ $# -ge 1 ]] || usage "block <id> [-m <理由>]"
  local id=$1 reason=""; shift
  valid_id "$id"
  while [[ $# -gt 0 ]]; do
    case $1 in
      -m|--message) need_arg "$@"; reason=$2; shift 2;;
      *) usage "block: 不明な引数 $1";;
    esac
  done
  local row cur; row=$(require_task "$id"); cur=$(jq -r .status <<<"$row")
  [[ $cur != done ]] || die "done のタスクは block できません: $id"
  sql "UPDATE tasks SET status='blocked', note=NULLIF($(q "$reason"),''), updated_at=$(q "$(now)") WHERE id=$(q "$id");"
  echo "$id blocked"
}

# ---------- report ----------
# 宛先の状態を見て、idle/done のときだけ送る。0=送信済み 10=宛先が使用中 11=状態取得/送信の失敗
herdr_send() {  # $1=宛先 $2=本文 $3=ログ用 ID [$4=種別(report|comment|digest|send)]
  local target=$1 msg=$2 id=$3 kind=${4:-report} st out
  st=$("$HERDR_BIN" agent get "$target" 2>/dev/null | jq -r '.result.agent.agent_status // empty' 2>/dev/null) || st=""
  case $st in
    idle|done) ;;
    "") log_message "$kind" "$id" "$target" "$msg" failed
        echo "tb: 宛先 '$target' の状態を取得できません。未送信(pending に残す): $id" >&2; return 11;;
    *)  log_message "$kind" "$id" "$target" "$msg" busy
        echo "tb: 宛先 '$target' が $st のため送りません。未送信(pending に残す): $id" >&2; return 10;;
  esac
  if ! out=$("$HERDR_BIN" agent prompt "$target" "$msg" 2>&1) || jq -e 'type=="object" and has("error")' <<<"$out" >/dev/null 2>&1; then
    log_message "$kind" "$id" "$target" "$msg" failed
    echo "tb: 送信に失敗しました。未送信(pending に残す): $id" >&2
    echo "$out" >&2
    return 11
  fi
  log_message "$kind" "$id" "$target" "$msg" sent
}

# 送信の記録はアプリ(tb)が書く。agent の自己申告に頼らない
log_message() {  # $1=kind $2=ref $3=target $4=body $5=sent|busy|failed
  sql "INSERT INTO messages (kind, ref, target, body, result, created_at)
    VALUES ($(q "$1"), $(q "$2"), $(q "$3"), $(q "$4"), $(q "$5"), $(q "$(now)"));" >/dev/null || true
}

cmd_report() {
  [[ $# -eq 1 ]] || usage "report <id>"
  if [[ $1 =~ ^C-[0-9]+$ ]]; then deliver_comment "${1#C-}"; return $?; fi   # 未配送コメントの再送
  local id=$1; valid_id "$id"
  local row status project summary paths reported target msg
  row=$(require_task "$id")
  status=$(jq -r .status <<<"$row"); project=$(jq -r .project <<<"$row")
  summary=$(jq -r '.summary // ""' <<<"$row"); reported=$(jq -r '.reported_at // ""' <<<"$row")
  paths=$(jq -r '.deliverables | fromjson | join(", ")' <<<"$row")
  [[ $status == done ]] || die "done ではないタスクは report できません($status): $id"
  if [[ -n $reported ]]; then echo "$id は報告済みです($reported)"; return 0; fi

  target=$(target_for "$project")
  # prompt は 1 行にする(改行が入ると途中で submit されうる)
  summary=$(printf '%s' "$summary" | tr '\r\n\t' '   ' | tr -s ' ')
  summary=${summary%"${summary##*[![:space:]]}"}
  msg="[$id done] $summary / $paths"
  herdr_send "$target" "$msg" "$id" || return $?
  sql "UPDATE tasks SET reported_at=$(q "$(now)"), updated_at=$(q "$(now)") WHERE id=$(q "$id");"
  echo "$id reported to $target"
}

# ---------- pending ----------
cmd_pending() {
  local mode=tsv
  while [[ $# -gt 0 ]]; do
    case $1 in
      --json) mode=json; shift;;
      --ids)  mode=ids; shift;;
      *) usage "pending: 不明な引数 $1";;
    esac
  done
  local where="status='done' AND (reported_at IS NULL OR reported_at='')"
  case $mode in
    ids)  sql "SELECT id FROM tasks WHERE $where ORDER BY updated_at, id;"
          sql "SELECT 'C-'||id FROM comments WHERE delivered_at IS NULL ORDER BY id;";;
    json) sql -json "SELECT * FROM tasks WHERE $where ORDER BY updated_at, id;" | jq -c '(. // [])[] | .deliverables |= fromjson'
          sql -json "SELECT * FROM comments WHERE delivered_at IS NULL ORDER BY id;" | jq -c '(. // [])[] | .deliverables |= fromjson | .id = "C-\(.id)"';;
    tsv)  local id project summary
          while IFS=$'\t' read -r id project summary; do
            printf '%s\t%s\t%s\t%s\n' "$id" "$project" "$(target_for "$project")" "$summary"
          done < <(sql -separator $'\t' "SELECT id, project, replace(replace(COALESCE(summary,''), char(10), ' '), char(9), ' ') FROM tasks WHERE $where ORDER BY updated_at, id;")
          # 未配送のコメント: ID は C-<n>(tb report C-<n> で再送)
          while IFS=$'\t' read -r id project summary; do
            printf '%s\t%s\t%s\t%s\n' "$id" "$project" "$(target_for "$project")" "$summary"
          done < <(sql -separator $'\t' "SELECT 'C-'||c.id, COALESCE(t.project,''), '['||c.kind||'] '||substr(replace(replace(c.text, char(10), ' '), char(9), ' '),1,80)
            FROM comments c LEFT JOIN tasks t ON t.id=c.task_id WHERE c.delivered_at IS NULL ORDER BY c.id;");;
  esac
}

# ---------- 代行依頼(判定と記録だけ。cmd は実行しない) ----------
ALLOWLIST=${TB_ALLOWLIST:-$TB_ROOT/config/proxy-allowlist.txt}
EFFECTS="read-only write external"
valid_pid() { [[ $1 =~ ^[0-9]+$ ]] || usage "代行依頼の ID は数字: $1"; }
trim() { local s=$1; s=${s#"${s%%[![:space:]]*}"}; s=${s%"${s##*[![:space:]]}"}; printf '%s' "$s"; }

cmd_proxy-request() {
  [[ $# -ge 1 ]] || usage "proxy-request <task-id> --cmd C --why W --effect read-only|write|external [--expect E]"
  local tid=$1 c="" why="" effect="" expect=""; shift
  valid_id "$tid"
  while [[ $# -gt 0 ]]; do
    case $1 in
      --cmd)    need_arg "$@"; c=$2; shift 2;;
      --why)    need_arg "$@"; why=$2; shift 2;;
      --effect) need_arg "$@"; effect=$2; shift 2;;
      --expect) need_arg "$@"; expect=$2; shift 2;;
      *) usage "proxy-request: 不明な引数 $1";;
    esac
  done
  c=$(trim "$c")
  blank "$c" && usage "proxy-request: --cmd が必要です"
  blank "$why" && usage "proxy-request: --why が必要です"
  [[ -n $effect ]] || usage "proxy-request: --effect が必須です(read-only|write|external。迷ったら write)"
  [[ " $EFFECTS " == *" $effect "* ]] || usage "proxy-request: --effect は $EFFECTS のどれか: $effect"
  require_task "$tid" >/dev/null
  local prior status=open result="" n id; n=$(now)
  prior=$(sql "SELECT id FROM proxy_requests WHERE cmd=$(q "$c") AND status='denied' ORDER BY id LIMIT 1;")
  if [[ -n $prior ]]; then
    status=denied; result="同一 cmd が人に拒否済み(依頼 $prior)。同じ依頼は出し直さず、別の方法を提案すること"
  fi
  id=$(sql "INSERT INTO proxy_requests (task_id, cmd, why, effect, expect, status, result, created_at, updated_at)
            VALUES ($(q "$tid"), $(q "$c"), $(q "$why"), $(q "$effect"), NULLIF($(q "$expect"),''), $(q "$status"),
                    NULLIF($(q "$result"),''), $(q "$n"), $(q "$n")); SELECT last_insert_rowid();")
  [[ $status == denied ]] && echo "tb: $result" >&2
  echo "$id $status"
}

cmd_proxy-list() {
  local status="" json=0 where="1=1"
  while [[ $# -gt 0 ]]; do
    case $1 in
      --status) need_arg "$@"; status=$2; shift 2;;
      --json)   json=1; shift;;
      *) usage "proxy-list: 不明な引数 $1";;
    esac
  done
  if [[ -n $status ]]; then
    [[ $status =~ ^(open|done|pending-human|denied)$ ]] || usage "proxy-list: status は open|done|pending-human|denied: $status"
    where+=" AND status=$(q "$status")"
  fi
  if ((json)); then
    sql -json "SELECT * FROM proxy_requests WHERE $where ORDER BY id;" | jq -c '(. // [])[]'
  else
    sql -separator $'\t' "SELECT id, status, effect, task_id, replace(replace(cmd, char(10), ' '), char(9), ' ') FROM proxy_requests WHERE $where ORDER BY id;"
  fi
}

cmd_proxy-resolve() {
  [[ $# -ge 1 ]] || usage "proxy-resolve <id> --status done|pending-human|denied [--result <本文かファイルパス>]"
  local id=$1 status="" result=""; shift
  valid_pid "$id"
  while [[ $# -gt 0 ]]; do
    case $1 in
      --status) need_arg "$@"; status=$2; shift 2;;
      --result) need_arg "$@"; result=$2; shift 2;;
      *) usage "proxy-resolve: 不明な引数 $1";;
    esac
  done
  [[ $status =~ ^(done|pending-human|denied)$ ]] || usage "proxy-resolve: --status は done|pending-human|denied のどれか"
  local cur; cur=$(sql "SELECT status FROM proxy_requests WHERE id=$id;")
  [[ -n $cur ]] || die "代行依頼が見つかりません: $id"
  [[ $cur == open || $cur == pending-human ]] || die "解決済み($cur)の依頼は変更できません: $id"
  sql "UPDATE proxy_requests SET status=$(q "$status"), result=NULLIF($(q "$result"),''), updated_at=$(q "$(now)") WHERE id=$id;"
  echo "$id $status"
}

# cmd に含まれる「副作用・連鎖・展開」の兆候を META に入れる(クォート内でも拾う。安全側に倒す)
detect_meta() {
  local c=$1; META=()
  [[ $c == *'>'* ]] && META+=("リダイレクト(>)")
  [[ $c == *'<'* ]] && META+=("リダイレクト(<)")
  [[ $c == *'|'* ]] && META+=("パイプ/||")
  [[ $c == *';'* ]] && META+=("連結(;)")
  [[ $c == *'&'* ]] && META+=("連結/バックグラウンド(&, &&)")
  [[ $c == *'$'* ]] && META+=("展開(\$, \$())")
  [[ $c == *'`'* ]] && META+=("バッククォート")
  [[ $c == *$'\n'* || $c == *$'\r'* ]] && META+=("改行")
  grep -Eiq -- '(^|[[:space:]])(-X|--request|--method)[[:space:]=]*(POST|PUT|DELETE|PATCH)' <<<"$c" && META+=("書き込み系の HTTP メソッド")
  grep -Eq -- '(^|[[:space:]])--(approve|merge|body|add)' <<<"$c" && META+=("書き込み系のフラグ(--approve/--merge/--body/--add)")
  grep -Eq -- '(^|[[:space:]])--output' <<<"$c" && META+=("ファイル出力(--output)")
  return 0
}

cmd_proxy-check() {
  [[ $# -eq 1 ]] || usage "proxy-check <id>"
  valid_pid "$1"
  local row c effect status
  row=$(sql -json "SELECT * FROM proxy_requests WHERE id=$1;" | jq -c '.[0] // empty')
  [[ -n $row ]] || die "代行依頼が見つかりません: $1"
  c=$(jq -r .cmd <<<"$row"); effect=$(jq -r .effect <<<"$row"); status=$(jq -r .status <<<"$row")

  local reasons=() mismatch="" META=()
  detect_meta "$c"
  if [[ ${#META[@]} -gt 0 ]]; then
    local metas; metas=$(IFS=、; echo "${META[*]}")
    reasons+=("危険な構文を含む: $metas")
    [[ $effect == read-only ]] && mismatch="申告は read-only だが、コマンドに $metas を含む"
  fi
  [[ $status == denied ]] && reasons+=("すでに denied")
  [[ $effect != read-only ]] && reasons+=("申告 effect が $effect")

  # 許可リスト(先頭一致。語の境界で比較: "git log" は "git log -5" に一致、"git logx" には一致しない)
  local matched="" line
  if [[ -r $ALLOWLIST ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      line=$(trim "$line")
      [[ -z $line || $line == \#* ]] && continue
      if [[ $c == "$line" || $c == "$line "* || $c == "$line"$'\t'* ]]; then matched=$line; break; fi
    done <"$ALLOWLIST"
    [[ -n $matched ]] || reasons+=("許可リストにない")
  else
    reasons+=("許可リストを読めない($ALLOWLIST)。安全側で human")
  fi

  if [[ ${#reasons[@]} -eq 0 ]]; then
    echo allow
    echo "match: $matched"
  else
    echo human
    local r; for r in "${reasons[@]}"; do echo "reason: $r"; done
  fi
  [[ -z $mismatch ]] || echo "mismatch: $mismatch"
  return 0
}

# ---------- touch / activity(hook から呼ばれる。agent を止めないことが最優先) ----------
TOUCH_LOG=${TB_TOUCH_LOG:-$(dirname "$DB")/touch-errors.log}
ID_RE='^[A-Za-z0-9._:-]{1,128}$'

# act_select N: working 推定と、N 分以上の滞留(stuck)を付けた SELECT(WHERE は呼び出し側)
act_select() {
  [[ $1 =~ ^[0-9]+$ ]] || usage "分は数字: $1"
  local w="last_prompt_at IS NOT NULL AND (last_stop_at IS NULL OR last_prompt_at > last_stop_at)"
  echo "SELECT session_id, pane_id, tab_id, workspace_id, cwd, last_prompt_id, last_prompt_at, last_stop_at, updated_at,
    CASE WHEN $w THEN 1 ELSE 0 END AS working,
    CASE WHEN $w AND (julianday('now') - julianday(last_prompt_at)) * 1440 >= $1 THEN 1 ELSE 0 END AS stuck,
    CASE WHEN last_prompt_at IS NULL THEN NULL
         ELSE CAST((julianday('now') - julianday(last_prompt_at)) * 1440 AS INTEGER) END AS since_prompt_min
    FROM agent_activity"
}

# 失敗時は固定の理由コードだけを stdout に出して return 1。入力値・DB のエラー文は一切出さない
touch_impl() {
  local ev="" sid="" pane="" tab="" ws="" cwd="" pid=""
  while [[ $# -gt 0 ]]; do
    [[ $# -ge 2 ]] || { echo invalid-args; return 1; }
    case $1 in
      --event) ev=$2;; --session-id) sid=$2;; --pane-id) pane=$2;; --tab-id) tab=$2;;
      --workspace-id) ws=$2;; --cwd) cwd=$2;; --prompt-id) pid=$2;;
      *) echo invalid-args; return 1;;
    esac
    shift 2
  done
  [[ $ev == UserPromptSubmit || $ev == Stop ]] || { echo invalid-event; return 1; }
  [[ -n $sid ]] || { echo missing-session-id; return 1; }
  [[ $sid =~ $ID_RE ]] || { echo invalid-session-id; return 1; }
  local v
  for v in "$pane" "$tab" "$ws" "$pid"; do
    [[ -z $v || $v =~ $ID_RE ]] || { echo invalid-field; return 1; }
  done
  { [[ ${#cwd} -le 1024 ]] && [[ $cwd != *$'\n'* ]]; } || { echo invalid-cwd; return 1; }

  local ts="strftime('%Y-%m-%dT%H:%M:%fZ','now')" pa="NULL" sa="NULL" err
  if [[ $ev == UserPromptSubmit ]]; then pa=$ts; else sa=$ts; fi
  local SQL_TIMEOUT=1000   # ロックされていても 1 秒で諦める
  err=$({ init_db && sql "INSERT INTO agent_activity
      (session_id, pane_id, tab_id, workspace_id, cwd, last_prompt_id, last_prompt_at, last_stop_at, updated_at)
    VALUES ($(q "$sid"), NULLIF($(q "$pane"),''), NULLIF($(q "$tab"),''), NULLIF($(q "$ws"),''), NULLIF($(q "$cwd"),''),
            NULLIF($(q "$pid"),''), $pa, $sa, $ts)
    ON CONFLICT(session_id) DO UPDATE SET
      pane_id=COALESCE(excluded.pane_id, pane_id), tab_id=COALESCE(excluded.tab_id, tab_id),
      workspace_id=COALESCE(excluded.workspace_id, workspace_id), cwd=COALESCE(excluded.cwd, cwd),
      last_prompt_id=COALESCE(excluded.last_prompt_id, last_prompt_id),
      last_prompt_at=COALESCE(excluded.last_prompt_at, last_prompt_at),
      last_stop_at=COALESCE(excluded.last_stop_at, last_stop_at),
      updated_at=excluded.updated_at;"; } 2>&1) && return 0
  if grep -qiE 'locked|busy' <<<"$err"; then echo db-locked
  elif grep -qiE 'readonly|read-only|unable to open' <<<"$err"; then echo db-readonly
  else echo db-error; fi
  return 1
}

# 常に終了コード 0・標準出力/標準エラーなし。失敗は touch-errors.log に 1 行(時刻・event・理由コードのみ)
cmd_touch() {
  {
    local reason prev="" a ev="-"
    for a in "$@"; do
      [[ $prev == --event && ( $a == UserPromptSubmit || $a == Stop ) ]] && ev=$a
      prev=$a
    done
    if ! reason=$(touch_impl "$@" 2>/dev/null); then
      mkdir -p "$(dirname "$TOUCH_LOG")" 2>/dev/null || true
      printf '%s event=%s reason=%s\n' "$(now)" "$ev" "${reason:-unknown}" >>"$TOUCH_LOG" 2>/dev/null || true
    fi
  } >/dev/null 2>&1
  return 0
}

cmd_activity() {
  local json=0 stuck=10
  while [[ $# -gt 0 ]]; do
    case $1 in
      --json) json=1; shift;;
      --stuck-min) need_arg "$@"; stuck=$2; shift 2;;
      *) usage "activity: 不明な引数 $1";;
    esac
  done
  local s; s=$(act_select "$stuck")
  if ((json)); then
    sql -json "$s ORDER BY updated_at DESC;" | jq -c '(. // [])[]'
  else
    sql -nullvalue - -separator $'\t' "SELECT session_id, COALESCE(pane_id,'-'), working, stuck, last_prompt_at, last_stop_at, COALESCE(cwd,'-')
      FROM ($s) ORDER BY updated_at DESC;"
  fi
}

# ---------- comment / comments(worker → 指揮官の報告コメント) ----------
COMMENT_KINDS="done progress question blocked"
# すぐ送る kind。それ以外は保存だけして tb digest でまとめて送る
IMMEDIATE_KINDS=${TB_IMMEDIATE_KINDS:-question blocked}
LABEL_NAME=""; LABEL_PANE=""; LABEL_SESSION=""

# 報告者ラベルは herdr から引く(自己申告にしない)。引けなければ 1 を返す(理由は stderr)
resolve_label() {
  local pane=${HERDR_PANE_ID:-} out row
  [[ -n $pane ]] || { echo "tb: HERDR_PANE_ID がありません。報告者を特定できないため保存しません" >&2; return 1; }
  out=$("$HERDR_BIN" agent list 2>/dev/null) || { echo "tb: herdr agent list に失敗。報告者を特定できないため保存しません" >&2; return 1; }
  row=$(jq -c --arg p "$pane" '[.result.agents[]? | select(.pane_id==$p)][0] // empty' <<<"$out" 2>/dev/null) || row=""
  [[ -n $row ]] || { echo "tb: pane $pane に該当する agent がありません。保存しません" >&2; return 1; }
  LABEL_NAME=$(jq -r '.name // ""' <<<"$row"); LABEL_SESSION=$(jq -r '.agent_session.value // ""' <<<"$row"); LABEL_PANE=$pane
  [[ -n $LABEL_NAME ]] || { echo "tb: pane $pane の agent に名前がありません(herdr agent rename)。保存しません" >&2; return 1; }
  [[ -n $LABEL_SESSION ]] || { echo "tb: pane $pane の agent に session がありません。保存しません" >&2; return 1; }
  [[ $LABEL_NAME =~ ^[A-Za-z0-9._-]{1,64}$ && $LABEL_PANE =~ ^[A-Za-z0-9._:-]{1,64}$ ]] \
    || { echo "tb: 報告者名/pane に使えない文字があります。保存しません" >&2; return 1; }
}

# 1 行化 + ラベル偽装の無効化 + 先頭 N 字
oneline() {  # $1=本文 $2=最大字数
  printf '%s' "$1" | tr '\r\n\t' '   ' | tr -d '\000-\010\013\014\016-\037' | tr -s ' ' \
    | jq -Rrs --argjson n "$2" 'gsub("\\[\\s*from\\s*[:：]";"(from:";"i") | gsub("^\\s+|\\s+$";"") | .[0:$n]'
}

deliver_comment() {  # $1=comments.id → 0 送信済み / 10 / 11
  local cid=$1 row delivered tid kind text name pane project target msg
  [[ $cid =~ ^[0-9]+$ ]] || usage "コメント ID は C-<数字>"
  row=$(sql -json "SELECT * FROM comments WHERE id=$cid;" | jq -c '.[0] // empty')
  [[ -n $row ]] || die "コメントが見つかりません: C-$cid"
  delivered=$(jq -r '.delivered_at // ""' <<<"$row")
  if [[ -n $delivered ]]; then echo "C-$cid は配送済みです($delivered)"; return 0; fi
  tid=$(jq -r .task_id <<<"$row"); kind=$(jq -r .kind <<<"$row"); text=$(jq -r .text <<<"$row")
  name=$(jq -r .from_name <<<"$row"); pane=$(jq -r .from_pane <<<"$row")
  project=$(sql "SELECT project FROM tasks WHERE id=$(q "$tid");"); target=$(target_for "$project")
  msg="[from: $name / $pane / $tid / $kind] $(oneline "$text" 200) (詳細: tb comments $tid)"
  herdr_send "$target" "$msg" "C-$cid" comment || return $?
  sql "UPDATE comments SET delivered_at=$(q "$(now)") WHERE id=$cid;"
  echo "C-$cid delivered to $target"
}

# 終了コード: 0 配送済み / 10 保存済み・宛先使用中で未配送 / 11 保存済み・送信失敗 / 3 報告者を特定できず未保存 / 2 使い方 / 1 その他
cmd_comment() {
  [[ $# -ge 1 ]] || usage "comment <task-id> --kind done|progress|question|blocked --text T [--deliverables a,b] [--json]"
  local tid=$1 kind="" text="" dels="" json=0; shift
  valid_id "$tid"
  while [[ $# -gt 0 ]]; do
    case $1 in
      --kind) need_arg "$@"; kind=$2; shift 2;;
      --text) need_arg "$@"; text=$2; shift 2;;
      --deliverables) need_arg "$@"; dels=$2; shift 2;;
      --json) json=1; shift;;
      --from|--from-*|--name|--pane|--session) usage "comment: 報告者は herdr から自動で決まります。$1 は指定できません";;
      *) usage "comment: 不明な引数 $1";;
    esac
  done
  [[ " $COMMENT_KINDS " == *" $kind "* ]] || usage "comment: --kind は $COMMENT_KINDS のどれか"
  blank "$text" && usage "comment: --text が必要です"
  local darr="[]"
  if [[ -n $dels ]]; then
    darr=$(jq -nc --arg d "$dels" '$d | split(",") | map(gsub("^\\s+|\\s+$";"")) | map(select(length>0))')
  fi
  if [[ $kind == done && $darr == "[]" ]]; then usage "comment: done は --deliverables(成果物)が必須です"; fi
  require_task "$tid" >/dev/null
  resolve_label || return 3
  local cid rc=0
  cid=$(sql "INSERT INTO comments (task_id, kind, text, deliverables, from_name, from_pane, from_session, created_at)
    VALUES ($(q "$tid"), $(q "$kind"), $(q "$text"), $(q "$darr"), $(q "$LABEL_NAME"), $(q "$LABEL_PANE"), $(q "$LABEL_SESSION"), $(q "$(now)"));
    SELECT last_insert_rowid();")
  local state=queued
  if [[ " $IMMEDIATE_KINDS " == *" $kind "* ]]; then   # 人の判断待ちはすぐ送る。それ以外は tb digest でまとめて送る
    deliver_comment "$cid" >/dev/null || rc=$?   # 保存は済んでいる。配送の結果は終了コードで返す
    state=$([[ $rc == 0 ]] && echo delivered || echo saved-undelivered)
  fi
  if ((json)); then sql -json "SELECT * FROM comments WHERE id=$cid;" | jq -c '.[0] | .deliverables |= fromjson | .id = "C-\(.id)"'
  else echo "C-$cid $state"; fi
  return $rc
}

cmd_comments() {
  local tid="" kind="" und=0 json=0 where="1=1"
  if [[ ${1:-} == T-* ]]; then tid=$1; shift; valid_id "$tid"; fi
  while [[ $# -gt 0 ]]; do
    case $1 in
      --kind) need_arg "$@"; kind=$2; shift 2;;
      --undelivered) und=1; shift;;
      --json) json=1; shift;;
      *) usage "comments: 不明な引数 $1";;
    esac
  done
  [[ -z $tid ]] || where+=" AND task_id=$(q "$tid")"
  if [[ -n $kind ]]; then [[ " $COMMENT_KINDS " == *" $kind "* ]] || usage "comments: --kind は $COMMENT_KINDS"; where+=" AND kind=$(q "$kind")"; fi
  ((und)) && where+=" AND delivered_at IS NULL"
  if ((json)); then
    sql -json "SELECT * FROM comments WHERE $where ORDER BY id;" | jq -c '(. // [])[] | .deliverables |= fromjson | .id = "C-\(.id)"'
  else
    # needs_human: question/blocked は人の判断・承認待ち
    sql -separator $'\t' "SELECT 'C-'||id, kind, CASE WHEN kind IN ('question','blocked') THEN 'needs-human' ELSE '-' END,
      CASE WHEN delivered_at IS NULL THEN 'undelivered' ELSE 'delivered' END, task_id, from_name,
      replace(replace(text, char(10), ' '), char(9), ' ') FROM comments WHERE $where ORDER BY id;"
  fi
}

# ---------- digest(worker → 指揮官のまとめ送信。scheduler から 10 分おきに呼ぶ想定) ----------
# 未配送の報告・未報告の done・tb が観測した事象を、指揮官ごとに 1 通にまとめて送る。
# 観測は worker の自己申告に頼らない: turn が終わったのに in_progress のまま / 長時間 working / blocked(承認待ち)
DIGEST_IDLE_MIN=${TB_DIGEST_IDLE_MIN:-10}
DIGEST_STUCK_MIN=${TB_DIGEST_STUCK_MIN:-30}
DIGEST_ITEM_MAX=${TB_DIGEST_ITEM_MAX:-160}
DIGEST_MSG_MAX=${TB_DIGEST_MSG_MAX:-1800}

# 項目の本文: 1 行化(oneline)に加え、項目の区切り(|)と角かっこラベルを無効化する
item_text() { oneline "$1" "$2" | tr '[]|' '()/'; }

DIGEST_ITEMS=""
add_item() {  # $1=target $2=type(comment|task|obs) $3=ref $4=key $5=task_id $6=obs_kind $7=label $8=本文
  DIGEST_ITEMS+=$(jq -nc --arg target "$1" --arg type "$2" --arg ref "$3" --arg key "$4" --arg task "$5" \
    --arg okind "$6" --arg short "[$7] $(item_text "$8" "$DIGEST_ITEM_MAX")" --arg full "[$7] $(item_text "$8" 2000)" \
    '{target:$target,type:$type,ref:$ref,key:$key,task:$task,okind:$okind,short:$short,full:$full}')$'\n'
}
obs_seen() { [[ -n $(sql "SELECT 1 FROM observations WHERE key=$(q "$1");") ]]; }

collect_digest() {
  local r tid kind from text dels project id owner summary key m pane sess name list task
  # 1. 未配送の報告コメント(kind を問わない。即時送信に失敗したものもここで回収)
  while IFS= read -r r; do
    [[ -n $r ]] || continue
    id=$(jq -r .id <<<"$r"); tid=$(jq -r .task_id <<<"$r"); kind=$(jq -r .kind <<<"$r")
    from=$(jq -r .from_name <<<"$r"); text=$(jq -r .text <<<"$r"); project=$(jq -r '.project // ""' <<<"$r")
    dels=$(jq -r '.deliverables | fromjson | join(", ")' <<<"$r")
    [[ -n $dels ]] && text+=" / 成果物: $dels"
    add_item "$(target_for "$project")" comment "C-$id" "" "$tid" "" "$tid $kind / $from" "$text"
  done < <(sql -json "SELECT c.*, t.project FROM comments c LEFT JOIN tasks t ON t.id=c.task_id
             WHERE c.delivered_at IS NULL ORDER BY c.id;" | jq -c '(. // [])[]')
  # 2. done なのに未報告のタスク
  while IFS= read -r r; do
    [[ -n $r ]] || continue
    id=$(jq -r .id <<<"$r"); project=$(jq -r .project <<<"$r"); owner=$(jq -r '.owner_agent // "-"' <<<"$r")
    summary=$(jq -r '.summary // ""' <<<"$r"); dels=$(jq -r '.deliverables | fromjson | join(", ")' <<<"$r")
    add_item "$(target_for "$project")" task "$id" "" "$id" "" "$id done / $owner" "$summary / 成果物: $dels"
  done < <(sql -json "SELECT * FROM tasks WHERE status='done' AND (reported_at IS NULL OR reported_at='') ORDER BY updated_at, id;" | jq -c '(. // [])[]')
  # 2b. アラート: 新しく登録されたもの(まだまとめに入れていない)と、届いていない解析結果
  while IFS=$'\t' read -r id st title; do
    [[ -n $id ]] || continue
    key="alert:$id"; obs_seen "$key" && continue
    add_item "$DEFAULT_TARGET" obs "A-$id" "$key" "" alert "A-$id アラート / $st" "$title (tb alerts A-$id)"
  done < <(sql -separator $'\t' "SELECT id, status, replace(replace(title, char(10), ' '), char(9), ' ') FROM alerts WHERE status NOT IN ('closed') ORDER BY id;")
  while IFS=$'\t' read -r id sev title summary; do
    [[ -n $id ]] || continue
    add_item "$DEFAULT_TARGET" alert "A-$id" "" "" "" "A-$id 解析結果 / $sev" "$title — $summary (全文: tb alerts A-$id)"
  done < <(sql -separator $'\t' "SELECT id, severity, replace(replace(title, char(10), ' '), char(9), ' '), replace(replace(result_summary, char(10), ' '), char(9), ' ')
             FROM alerts WHERE status='analyzed' AND result_delivered_at IS NULL ORDER BY id;")
  # 3. 観測: turn が終わって DIGEST_IDLE_MIN 分たつのに in_progress のまま(done も報告もない)
  while IFS=$'\t' read -r id project owner key m; do
    [[ -n $id ]] || continue
    obs_seen "$key" && continue
    add_item "$(target_for "$project")" obs "$id" "$key" "$id" idle "$id 観測 / $owner" \
      "turn が終わって $m 分たつが、タスクは in_progress のまま(done・報告なし)"
  done < <(sql -separator $'\t' "SELECT t.id, t.project, COALESCE(t.owner_agent,'-'), 'idle:'||t.id||':'||a.last_stop_at,
             CAST((julianday('now') - julianday(a.last_stop_at)) * 1440 AS INTEGER)
             FROM tasks t JOIN agent_activity a ON a.session_id=t.session_id
             WHERE t.status='in_progress' AND a.last_stop_at IS NOT NULL
               AND (a.last_prompt_at IS NULL OR a.last_prompt_at <= a.last_stop_at)
               AND (julianday('now') - julianday(a.last_stop_at)) * 1440 >= $DIGEST_IDLE_MIN ORDER BY t.id;")
  # 4. 観測: DIGEST_STUCK_MIN 分以上 working のまま
  while IFS=$'\t' read -r id project owner key m; do
    [[ -n $id ]] || continue
    obs_seen "$key" && continue
    add_item "$(target_for "$project")" obs "$id" "$key" "$id" stuck "$id 観測 / $owner" \
      "$m 分 working のまま(長い作業か停止かは区別できない)"
  done < <(sql -separator $'\t' "SELECT t.id, t.project, COALESCE(t.owner_agent,'-'), 'stuck:'||a.session_id||':'||a.last_prompt_at,
             CAST((julianday('now') - julianday(a.last_prompt_at)) * 1440 AS INTEGER)
             FROM tasks t JOIN agent_activity a ON a.session_id=t.session_id
             WHERE t.status IN ('in_progress','review','blocked') AND a.last_prompt_at IS NOT NULL
               AND (a.last_stop_at IS NULL OR a.last_prompt_at > a.last_stop_at)
               AND (julianday('now') - julianday(a.last_prompt_at)) * 1440 >= $DIGEST_STUCK_MIN ORDER BY t.id;")
  # 5. 観測: herdr 上で blocked(承認ダイアログ待ちなど)の agent。担当タスクがあるものだけ
  if list=$("$HERDR_BIN" agent list 2>/dev/null) && jq -e '.result.agents' <<<"$list" >/dev/null 2>&1; then
    local current=""
    while IFS=$'\x1f' read -r pane name sess; do
      [[ -n $pane ]] || continue
      key="blocked:$pane:$sess"; current+="$(q "$key"),"
      obs_seen "$key" && continue
      task=$(sql -separator $'\t' "SELECT id, project FROM tasks WHERE status!='done'
               AND ((session_id IS NOT NULL AND session_id=$(q "$sess")) OR (owner_agent IS NOT NULL AND owner_agent=$(q "$name")))
               ORDER BY updated_at DESC LIMIT 1;")
      [[ -n $task ]] || continue
      id=${task%%$'\t'*}; project=${task#*$'\t'}
      add_item "$(target_for "$project")" obs "$id" "$key" "$id" blocked "$id 観測 / ${name:-$pane}" \
        "blocked のまま(承認ダイアログ待ちの可能性。herdr agent attach ${name:-$pane} で確認)"
    done < <(jq -r '.result.agents[] | select(.agent_status=="blocked") | [.pane_id, (.name // ""), (.agent_session.value // "")] | map(tostring | gsub("[\u001f\n]"; " ")) | join("\u001f")' <<<"$list")
    # blocked でなくなった agent の記録は消す(再び blocked になったら、また送る)
    sql "DELETE FROM observations WHERE kind='blocked' AND key NOT IN (${current}'');"
  fi
}

# 1 通分の本文を組み立てる。長さの上限に収まる項目だけを入れ、残りは次回に回す
# stdout: 1 行目=入れた項目数、2 行目=送る本文(1 行)
build_digest() {  # $1=target の項目(JSON 行) $2=digest ID
  local items=$1 did=$2 total n=0 body tail line acc=""   # 80 = 見出し・「残り N 件」の分
  total=$(grep -c . <<<"$items")
  while IFS= read -r line; do
    local s; s=$(jq -r .short <<<"$line")
    tail=" (全文: tb digests D-$did)"
    local cand="${acc:+$acc | }($((n+1))) $s"
    if (( n > 0 && ${#cand} + ${#tail} + 80 > DIGEST_MSG_MAX )); then break; fi
    acc=$cand; n=$((n+1))
  done <<<"$items"
  body="[digest D-$did / $n 件 / $(now)] $acc"
  (( n < total )) && body+=" (残り $((total-n)) 件は次回)"
  body+=" (全文: tb digests D-$did)"
  printf '%s\n%s\n' "$n" "$body"
}

cmd_digest() {
  local dry=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --dry-run) dry=1; shift;;
      *) usage "digest: 不明な引数 $1";;
    esac
  done
  [[ $DIGEST_IDLE_MIN =~ ^[0-9]+$ && $DIGEST_STUCK_MIN =~ ^[0-9]+$ ]] || usage "TB_DIGEST_IDLE_MIN / TB_DIGEST_STUCK_MIN は数字"
  ((dry)) || cmd_flush >/dev/null 2>&1 || true   # 積まれた下りの送信も届ける(結果は outbox / messages に残る)
  ((dry)) || cmd_alert-dispatch >/dev/null 2>&1 || true   # 承認・上限待ちのアラートを進める
  DIGEST_ITEMS=""
  collect_digest
  [[ -n $DIGEST_ITEMS ]] || { echo "digest: 送るものはありません"; return 0; }
  local rc=0 target items did out n body full sel
  while IFS= read -r target; do
    items=$(jq -c --arg t "$target" 'select(.target==$t)' <<<"$DIGEST_ITEMS")
    if ((dry)); then
      out=$(build_digest "$items" "?"); printf '%s\t%s\n' "$target" "$(sed -n 2p <<<"$out")"; continue
    fi
    did=$(sql "INSERT INTO digests (target, item_count, body, created_at) VALUES ($(q "$target"), 0, '', $(q "$(now)")); SELECT last_insert_rowid();")
    out=$(build_digest "$items" "$did"); n=$(sed -n 1p <<<"$out"); body=$(sed -n 2p <<<"$out")
    sel=$(head -n "$n" <<<"$items")
    if herdr_send "$target" "$body" "D-$did" digest; then
      full=$(jq -r .full <<<"$sel")
      sql "UPDATE digests SET item_count=$n, body=$(q "$full") WHERE id=$did;"
      local ts; ts=$(now)
      while IFS= read -r r; do
        local type ref; type=$(jq -r .type <<<"$r"); ref=$(jq -r .ref <<<"$r")
        case $type in
          comment) sql "UPDATE comments SET delivered_at=$(q "$ts") WHERE id=${ref#C-} AND delivered_at IS NULL;";;
          task)    sql "UPDATE tasks SET reported_at=$(q "$ts"), updated_at=$(q "$ts") WHERE id=$(q "$ref") AND reported_at IS NULL;";;
          alert)   sql "UPDATE alerts SET result_delivered_at=$(q "$ts") WHERE id=${ref#A-} AND result_delivered_at IS NULL;";;
          obs)     sql "INSERT OR IGNORE INTO observations (key, kind, task_id, text, digest_id, created_at)
                        VALUES ($(q "$(jq -r .key <<<"$r")"), $(q "$(jq -r .okind <<<"$r")"), $(q "$ref"), $(q "$(jq -r .full <<<"$r")"), $did, $(q "$ts"));";;
        esac
      done <<<"$sel"
      echo "D-$did sent to $target ($n 件)"
    else
      local e=$?
      sql "DELETE FROM digests WHERE id=$did;"   # 送れなかった回は残さない(messages には残る)。項目は次回に持ち越す
      (( e > rc )) && rc=$e
    fi
  done < <(jq -r .target <<<"$DIGEST_ITEMS" | awk '!seen[$0]++')
  return $rc
}

cmd_digests() {
  local did="" json=0
  if [[ ${1:-} == D-* ]]; then did=${1#D-}; shift; [[ $did =~ ^[0-9]+$ ]] || usage "digest ID は D-<数字>"; fi
  while [[ $# -gt 0 ]]; do
    case $1 in
      --json) json=1; shift;;
      *) usage "digests: 不明な引数 $1";;
    esac
  done
  if [[ -n $did ]]; then
    local row; row=$(sql -json "SELECT * FROM digests WHERE id=$did;" | jq -c '.[0] // empty')
    [[ -n $row ]] || die "digest が見つかりません: D-$did"
    if ((json)); then jq -c '.id = "D-\(.id)"' <<<"$row"; else jq -r '"D-\(.id) → \(.target) (\(.item_count) 件, \(.created_at))\n\(.body)"' <<<"$row"; fi
  elif ((json)); then
    sql -json "SELECT * FROM digests ORDER BY id DESC LIMIT 50;" | jq -c '(. // [])[] | .id = "D-\(.id)"'
  else
    sql -separator $'\t' "SELECT 'D-'||id, target, item_count, created_at FROM digests ORDER BY id DESC LIMIT 50;"
  fi
}

# ---------- send(指揮官 → worker の下り。agent は herdr agent prompt を直接打たず、これを使う) ----------
# 送信者は HERDR_PANE_ID + herdr agent list から決まる(自己申告にしない)。宛先は config/routes.conf のルールで許可されたものだけ。
# 宛先が使用中なら outbox に積み、tb flush(tb digest からも呼ばれる)で後から届ける。送ろうとしたものはすべて outbox と messages に残る。
ROUTES=${TB_ROUTES:-$TB_ROOT/config/routes.conf}
SEND_KINDS="task info answer"
SEND_MAX=${TB_SEND_MAX:-4000}

# 指揮官として扱う名前: 既定の宛先と projects.conf の値
conductor_names() {
  local k v
  printf '%s\n' "$DEFAULT_TARGET"
  [[ -f $CONF ]] || return 0
  while IFS='=' read -r k v || [[ -n $k ]]; do
    k=${k//[[:space:]]/}; v=${v//[[:space:]]/}
    [[ -z $k || $k == \#* || -z $v ]] && continue
    printf '%s\n' "$v"
  done <"$CONF"
}

# route_allowed <from> <to>: 0 なら許可。理由は ROUTE_REASON に入る
# routes.conf の各行は "<送信者のパターン> -> <宛先のパターン>"(* と ? の glob)。最初に一致した行で決まる。
# 行頭に ! を付けると拒否。routes.conf が無いときは「指揮官 → 誰でも」だけを許可する
ROUTE_REASON=""
route_allowed() {
  local from=$1 to=$2 line neg l r n
  if [[ ! -f $ROUTES ]]; then
    while IFS= read -r n; do
      [[ $from == "$n" ]] && { ROUTE_REASON="default: conductor $n"; return 0; }
    done < <(conductor_names)
    ROUTE_REASON="default: $from は指揮官ではない(worker からの報告は tb comment を使う)"; return 1
  fi
  while IFS= read -r line || [[ -n $line ]]; do
    line=$(trim "${line%%#*}"); [[ -n $line ]] || continue
    neg=0; [[ $line == \!* ]] && { neg=1; line=$(trim "${line#!}"); }
    [[ $line == *"->"* ]] || continue
    l=$(trim "${line%%->*}"); r=$(trim "${line#*->}")
    # shellcheck disable=SC2053  # glob として比べる
    if [[ $from == $l && $to == $r ]]; then
      if ((neg)); then ROUTE_REASON="routes.conf: !$l -> $r"; return 1; fi
      ROUTE_REASON="routes.conf: $l -> $r"; return 0
    fi
  done <"$ROUTES"
  ROUTE_REASON="routes.conf: $from -> $to に一致する行がない"; return 1
}

outbox_deliver() {  # $1=outbox.id → 0 送信済み / 10 / 11
  local oid=$1 row st from pane target kind tid text msg
  row=$(sql -json "SELECT * FROM outbox WHERE id=$oid;" | jq -c '.[0] // empty')
  [[ -n $row ]] || die "outbox が見つかりません: O-$oid"
  st=$(jq -r .status <<<"$row")
  [[ $st == queued ]] || { echo "O-$oid は $st です"; return 0; }
  from=$(jq -r .from_name <<<"$row"); pane=$(jq -r .from_pane <<<"$row"); target=$(jq -r .target <<<"$row")
  kind=$(jq -r .kind <<<"$row"); tid=$(jq -r '.task_id // "-"' <<<"$row"); text=$(jq -r .text <<<"$row")
  msg="[from: $from / $pane / $tid / $kind] $(oneline "$text" "$SEND_MAX")"
  herdr_send "$target" "$msg" "O-$oid" send || return $?
  sql "UPDATE outbox SET status='sent', sent_at=$(q "$(now)") WHERE id=$oid;"
}

# 終了コード: 0 送信済み / 10 宛先使用中で outbox に積んだ / 11 送信失敗で outbox に積んだ / 4 ルールで拒否(記録のみ)
#             20 人の承認待ち(approvals.conf が ask。人が tb approve O-<n>) / 3 送信者を特定できず未保存
cmd_send() {
  [[ $# -ge 1 ]] || usage "send <宛先 agent 名> --text T [--task T-..] [--kind task|info|answer] [--json]"
  local target=$1 text="" tid="" kind=task json=0; shift
  while [[ $# -gt 0 ]]; do
    case $1 in
      --text) need_arg "$@"; text=$2; shift 2;;
      --task) need_arg "$@"; tid=$2; shift 2;;
      --kind) need_arg "$@"; kind=$2; shift 2;;
      --json) json=1; shift;;
      --from|--from-*|--name|--pane|--session) usage "send: 送信者は herdr から自動で決まります。$1 は指定できません";;
      *) usage "send: 不明な引数 $1";;
    esac
  done
  [[ $target =~ ^[A-Za-z0-9._-]{1,64}$ ]] || usage "send: 宛先は agent 名(英数字と . _ -): $target"
  [[ " $SEND_KINDS " == *" $kind "* ]] || usage "send: --kind は $SEND_KINDS のどれか"
  blank "$text" && usage "send: --text が必要です"
  [[ -z $tid ]] || { valid_id "$tid"; require_task "$tid" >/dev/null; }
  resolve_label || return 3
  [[ $target != "$LABEL_NAME" ]] || usage "send: 自分自身には送れません"
  local names
  names=$("$HERDR_BIN" agent list 2>/dev/null | jq -r '.result.agents[]?.name // empty' 2>/dev/null) || names=""
  grep -qxF -- "$target" <<<"$names" || die "send: 宛先の agent が herdr にいません: $target(保存しません)"
  local status=queued reason="" rc=0 oid
  if ! route_allowed "$LABEL_NAME" "$target"; then status=denied; reason=$ROUTE_REASON
  else
    reason=$ROUTE_REASON
    approval_of "send:$kind:$target"
    [[ $APPROVAL_VALUE == allow ]] || status=pending
    reason+=" / approvals: $APPROVAL_RULE"
  fi
  oid=$(sql "INSERT INTO outbox (from_name, from_pane, from_session, target, kind, task_id, text, status, reason, created_at)
    VALUES ($(q "$LABEL_NAME"), $(q "$LABEL_PANE"), $(q "$LABEL_SESSION"), $(q "$target"), $(q "$kind"), NULLIF($(q "$tid"),''),
            $(q "$text"), $(q "$status"), $(q "$reason"), $(q "$(now)"));
    SELECT last_insert_rowid();")
  if [[ $status == denied ]]; then
    echo "tb: 送信を拒否しました($reason): O-$oid" >&2
    rc=4
  elif [[ $status == pending ]]; then
    echo "tb: 人の承認待ちです(approvals.conf: $APPROVAL_RULE)。人が tb approve O-$oid で届けます" >&2
    rc=20
  else
    outbox_deliver "$oid" >/dev/null || rc=$?
  fi
  if ((json)); then sql -json "SELECT * FROM outbox WHERE id=$oid;" | jq -c '.[0] | .id = "O-\(.id)"'
  else
    case $rc in 0) echo "O-$oid sent to $target";; 4) echo "O-$oid denied";; 20) echo "O-$oid pending-approval";; *) echo "O-$oid queued";; esac
  fi
  return $rc
}

# 積まれた送信を届ける。宛先ごとに古い順で、使用中の宛先は次回に回す
cmd_flush() {
  [[ $# -eq 0 ]] || usage "flush(引数なし)"
  local oid target rc=0 r busy=" "
  while IFS=$'\t' read -r oid target; do
    [[ -n $oid ]] || continue
    [[ $busy == *" $target "* ]] && continue   # 同じ宛先の後続は順序を保つため送らない
    r=0; outbox_deliver "$oid" || r=$?
    if ((r)); then busy+="$target "; ((r > rc)) && rc=$r; fi
  done < <(sql -separator $'\t' "SELECT id, target FROM outbox WHERE status='queued' ORDER BY id;")
  return $rc
}

cmd_outbox() {
  local st="" json=0 where="1=1"
  while [[ $# -gt 0 ]]; do
    case $1 in
      --status) need_arg "$@"; st=$2; shift 2;;
      --json) json=1; shift;;
      *) usage "outbox: 不明な引数 $1";;
    esac
  done
  if [[ -n $st ]]; then [[ $st =~ ^(pending|queued|sent|denied)$ ]] || usage "outbox: --status は pending|queued|sent|denied"; where="status=$(q "$st")"; fi
  if ((json)); then sql -json "SELECT * FROM outbox WHERE $where ORDER BY id DESC LIMIT 100;" | jq -c '(. // [])[] | .id = "O-\(.id)"'
  else sql -nullvalue - -separator $'\t' "SELECT 'O-'||id, status, from_name, target, kind, COALESCE(task_id,'-'), created_at,
         substr(replace(replace(text, char(10), ' '), char(9), ' '),1,80) FROM outbox WHERE $where ORDER BY id DESC LIMIT 100;"
  fi
}

# ---------- roles(agent ごとの役割の配布。SessionStart hook と一括送信) ----------
ROLES_DIR=${TB_ROLES:-$TB_ROOT/../roles}
ROLE_MAX=${TB_ROLE_MAX:-12000}
ROLE_FILE=""; ROLE_HASH=""; ROLE_TEXT=""

sha256() { if command -v sha256sum >/dev/null; then sha256sum | cut -c1-64; else shasum -a 256 | cut -c1-64; fi; }

role_file_for() {  # $1=agent 名 → 役割ファイルのパス(無ければ空)
  local name=$1 k v pat
  [[ $name =~ ^[A-Za-z0-9._-]{1,64}$ && $name != _* && $name != README ]] || return 0
  if [[ -f $ROLES_DIR/$name.md ]]; then printf '%s' "$ROLES_DIR/$name.md"; return 0; fi
  [[ -f $ROLES_DIR/map.conf ]] || return 0
  while IFS='=' read -r k v || [[ -n $k ]]; do
    pat=$(trim "${k%%#*}"); v=$(trim "${v%%#*}")
    [[ -n $pat && -n $v && $v =~ ^[A-Za-z0-9._-]+$ ]] || continue
    # shellcheck disable=SC2053  # glob として比べる
    if [[ $name == $pat ]]; then
      [[ -f $ROLES_DIR/$v.md ]] && printf '%s' "$ROLES_DIR/$v.md"
      return 0
    fi
  done <"$ROLES_DIR/map.conf"
}

# ROLE_FILE / ROLE_HASH / ROLE_TEXT を埋める。渡すものが無ければ 1
load_role() {  # $1=agent 名
  local body=""
  ROLE_FILE=$(role_file_for "$1"); ROLE_HASH=""; ROLE_TEXT=""
  [[ -f $ROLES_DIR/_common.md ]] && body+="$(cat "$ROLES_DIR/_common.md")"$'\n\n'
  [[ -n $ROLE_FILE ]] && body+="$(cat "$ROLE_FILE")"$'\n'
  blank "$body" && return 1
  ROLE_HASH=$(printf '%s' "$body" | sha256)
  if (( ${#body} > ROLE_MAX )); then body="${body:0:ROLE_MAX}"$'\n\n(長すぎるため途中で切りました。全文は roles/ を読んでください)'; fi
  ROLE_TEXT="# あなたの役割(agent 名: $1。roles/ から自動で渡しています。版 ${ROLE_HASH:0:12})"$'\n\n'"$body"
}

last_briefed_hash() {  # $1=session_id
  sql "SELECT hash FROM role_briefings WHERE session_id=$(q "$1") ORDER BY id DESC LIMIT 1;"
}
record_briefing() {  # session agent file hash source via
  sql "INSERT INTO role_briefings (session_id, agent, role_file, hash, source, via, created_at)
    VALUES ($(q "$1"), $(q "$2"), NULLIF($(q "$3"),''), $(q "$4"), $(q "$5"), $(q "$6"), $(q "$(now)"));" >/dev/null
}

agent_name_by_pane() {  # $1=pane → 名前(無ければ空)
  "$HERDR_BIN" agent list 2>/dev/null | jq -r --arg p "$1" '[.result.agents[]? | select(.pane_id==$p)][0].name // empty' 2>/dev/null
}

# SessionStart hook から呼ぶ(bin/tb-role-hook 経由)。常に終了コード 0。渡すときだけ stdout に hook 用の JSON を出す
cmd_role-context() {
  local src="" sid="" name
  while [[ $# -gt 0 ]]; do
    case $1 in
      --source) [[ $# -ge 2 ]] || return 0; src=$2; shift 2;;
      --session-id) [[ $# -ge 2 ]] || return 0; sid=$2; shift 2;;
      *) return 0;;
    esac
  done
  [[ $src =~ ^(startup|resume|clear|compact)$ && $sid =~ ^[A-Za-z0-9._-]{1,128}$ && -n ${HERDR_PANE_ID:-} ]] || return 0
  name=$(agent_name_by_pane "$HERDR_PANE_ID"); [[ -n $name ]] || return 0
  load_role "$name" || return 0
  # 同じ会話の再開で、同じ版を渡し済みなら渡さない(履歴に残っている)
  if [[ $src == resume && $(last_briefed_hash "$sid") == "$ROLE_HASH" ]]; then return 0; fi
  record_briefing "$sid" "$name" "${ROLE_FILE#"$ROLES_DIR"/}" "$ROLE_HASH" "$src" hook || true
  jq -nc --arg c "$ROLE_TEXT" '{hookSpecificOutput:{hookEventName:"SessionStart",additionalContext:$c}}'
}

# 動いている agent に役割(の置き場所)を送る。同じセッションに同じ版を渡し済みなら飛ばす
# 終了コード: 0 / 10 使用中で送れなかった agent がある / 11 送信失敗がある
cmd_role-broadcast() {
  local only=" $* " list rc=0 name pane sess files msg r
  list=$("$HERDR_BIN" agent list 2>/dev/null) || die "herdr agent list に失敗しました"
  while IFS=$'\x1f' read -r pane name sess; do
    [[ -n $name ]] || continue
    [[ $# -eq 0 || $only == *" $name "* ]] || continue
    if ! load_role "$name"; then echo "skip $name (役割ファイルなし)"; continue; fi
    if [[ -n $sess && $(last_briefed_hash "$sess") == "$ROLE_HASH" ]]; then echo "skip $name (渡し済み ${ROLE_HASH:0:12})"; continue; fi
    files="$(cd "$ROLES_DIR" && pwd)/_common.md"; [[ -n $ROLE_FILE ]] && files+=" $(cd "$(dirname "$ROLE_FILE")" && pwd)/$(basename "$ROLE_FILE")"
    msg="[role-update / tb] あなた($name)の役割が更新されました(版 ${ROLE_HASH:0:12})。次のファイルを読み、以後はこれに従ってください: $files"
    r=0; herdr_send "$name" "$msg" "role:$name" role 2>/dev/null || r=$?
    if ((r)); then echo "pending $name (宛先が使用中か送信失敗。あとで再実行)"; ((r > rc)) && rc=$r; continue; fi
    [[ -n $sess ]] && record_briefing "$sess" "$name" "${ROLE_FILE#"$ROLES_DIR"/}" "$ROLE_HASH" broadcast broadcast
    echo "sent $name (${ROLE_HASH:0:12})"
  done < <(jq -r '.result.agents[]? | [.pane_id, (.name // ""), (.agent_session.value // "")] | map(tostring | gsub("[\u001f\n]"; " ")) | join("\u001f")' <<<"$list")
  return $rc
}

# agent ごとの役割ファイルと、渡した版が最新か
cmd_roles() {
  local json=0 list name pane sess last at state
  [[ ${1:-} == --json ]] && json=1
  list=$("$HERDR_BIN" agent list 2>/dev/null) || die "herdr agent list に失敗しました"
  while IFS=$'\x1f' read -r pane name sess; do
    [[ -n $name ]] || continue
    last=""; at=""
    if load_role "$name"; then
      if [[ -n $sess ]]; then
        last=$(last_briefed_hash "$sess")
        at=$(sql "SELECT created_at FROM role_briefings WHERE session_id=$(q "$sess") ORDER BY id DESC LIMIT 1;")
      fi
      if [[ -z $last ]]; then state=never; elif [[ $last == "$ROLE_HASH" ]]; then state=current; else state=outdated; fi
    else state=no-role; fi
    if ((json)); then
      jq -nc --arg n "$name" --arg p "$pane" --arg f "${ROLE_FILE#"$ROLES_DIR"/}" --arg h "${ROLE_HASH:0:12}" --arg s "$state" --arg at "$at" \
        '{name:$n,pane:$p,role_file:$f,version:$h,state:$s,briefed_at:(if $at=="" then null else $at end)}'
    else
      printf '%s\t%s\t%s\t%s\t%s\n' "$name" "${ROLE_FILE#"$ROLES_DIR"/}" "${ROLE_HASH:0:12}" "$state" "${at:--}"
    fi
  done < <(jq -r '.result.agents[]? | [.pane_id, (.name // ""), (.agent_session.value // "")] | map(tostring | gsub("[\u001f\n]"; " ")) | join("\u001f")' <<<"$list")
}

# ---------- approvals(人の承認が要るか。config/approvals.conf) ----------
APPROVALS=${TB_APPROVALS:-$TB_ROOT/config/approvals.conf}
APPROVAL_RULE=""

valid_action() { [[ $1 =~ ^[A-Za-z0-9._:*?-]{1,128}$ ]] || usage "操作名に使えない文字があります: $1"; }

# approval_of <操作>: APPROVAL_VALUE に ask|allow、根拠の行を APPROVAL_RULE に入れる(サブシェルで呼ばない)
APPROVAL_VALUE=ask
approval_of() {
  local act=$1 line k v
  APPROVAL_RULE="(一致なし: 既定 ask)"; APPROVAL_VALUE=ask
  if [[ -f $APPROVALS ]]; then
    while IFS= read -r line || [[ -n $line ]]; do
      line=$(trim "${line%%#*}"); [[ $line == *=* ]] || continue
      k=$(trim "${line%%=*}"); v=$(trim "${line#*=}")
      [[ $v == ask || $v == allow ]] || continue
      # shellcheck disable=SC2053  # glob として比べる
      if [[ $act == $k ]]; then APPROVAL_RULE="$k = $v"; APPROVAL_VALUE=$v; return 0; fi
    done <"$APPROVALS"
  fi
}

# 人の端末からの実行か(agent の pane からは承認・設定変更をさせない)
require_human() {
  local pane=${HERDR_PANE_ID:-} n
  [[ -n $pane ]] || return 0
  n=$(agent_name_by_pane "$pane")
  [[ -z $n ]] || die "$1 は人が自分の端末で実行します(agent '$n' の pane からは実行できません)"
}

# tb approval <操作>: 1 行目 ask|allow、2 行目 rule:。終了コード 0=allow / 20=ask
cmd_approval() {
  [[ $# -eq 1 ]] || usage "approval <操作>(例: send:task:worker1, role:change)"
  valid_action "$1"
  approval_of "$1"
  printf '%s\nrule: %s\n' "$APPROVAL_VALUE" "$APPROVAL_RULE"
  [[ $APPROVAL_VALUE == allow ]] || return 20
}

# tb allow|ask <パターン>: 人が「今後は許可/承認制に戻す」を決める。同じパターンの行を書き換え、無ければ先頭に足す
set_approval() {  # $1=allow|ask $2=パターン
  local val=$1 pat=$2 tmp found=0 line k
  valid_action "$pat"
  require_human "tb $val"
  mkdir -p "$(dirname "$APPROVALS")"; touch "$APPROVALS"
  [[ -f $APPROVALS && ! -L $APPROVALS ]] || die "approvals.conf が通常ファイルではありません"
  tmp=$(mktemp "$APPROVALS.XXXXXX")
  {
    while IFS= read -r line || [[ -n $line ]]; do
      k=$(trim "${line%%#*}"); k=$(trim "${k%%=*}")
      if [[ $line != \#* && $line == *=* && $k == "$pat" ]]; then
        ((found)) || printf '%s = %s   # %s に人が変更\n' "$pat" "$val" "$(now)"
        found=1
      else
        printf '%s\n' "$line"
      fi
    done <"$APPROVALS"
  } >"$tmp"
  if ((!found)); then   # コメントの直後(最初のルールの前)に足す: 先に一致させるため
    awk -v rule="$pat = $val   # $(now) に人が追加" 'BEGIN{d=0} !d && $0 !~ /^#/ && $0 !~ /^[[:space:]]*$/ {print rule; d=1} {print} END{if(!d) print rule}' "$tmp" >"$tmp.2"
    mv "$tmp.2" "$tmp"
  fi
  mv "$tmp" "$APPROVALS"
  sql "INSERT INTO approval_changes (pattern, value, created_at) VALUES ($(q "$pat"), $(q "$val"), $(q "$(now)"));" >/dev/null
  echo "$pat = $val"
}
cmd_allow() { [[ $# -eq 1 ]] || usage "allow <操作のパターン>"; set_approval allow "$1"; }
cmd_ask()   { [[ $# -eq 1 ]] || usage "ask <操作のパターン>"; set_approval ask "$1"; }

# tb approve O-<n> [--always] / tb reject O-<n>: 人の承認待ちの送信を通す・止める
cmd_approve() {
  [[ $# -ge 1 && $1 =~ ^O-[0-9]+$ ]] || usage "approve O-<n> [--always]"
  local oid=${1#O-} always=0 row kind target; shift
  [[ ${1:-} == --always ]] && always=1
  require_human "tb approve"
  row=$(sql -json "SELECT * FROM outbox WHERE id=$oid;" | jq -c '.[0] // empty')
  [[ -n $row ]] || die "outbox が見つかりません: O-$oid"
  [[ $(jq -r .status <<<"$row") == pending ]] || die "O-$oid は承認待ちではありません($(jq -r .status <<<"$row"))"
  kind=$(jq -r .kind <<<"$row"); target=$(jq -r .target <<<"$row")
  sql "UPDATE outbox SET status='queued', reason=reason||' / 人が承認 $(now)' WHERE id=$oid;"
  ((always)) && set_approval allow "send:$kind:$target" >/dev/null && echo "send:$kind:$target = allow(今後は承認なし)"
  local r=0; outbox_deliver "$oid" >/dev/null || r=$?
  case $r in 0) echo "O-$oid approved and sent to $target";; *) echo "O-$oid approved (宛先使用中のため queued。tb flush で届く)";; esac
  return 0
}
cmd_reject() {
  [[ $# -eq 1 && $1 =~ ^O-[0-9]+$ ]] || usage "reject O-<n>"
  local oid=${1#O-}
  require_human "tb reject"
  [[ $(sql "SELECT status FROM outbox WHERE id=$oid;") == pending ]] || die "O-$oid は承認待ちではありません"
  sql "UPDATE outbox SET status='denied', reason=reason||' / 人が却下 $(now)' WHERE id=$oid;"
  echo "O-$oid rejected"
}

# ---------- alerts(見張り役が見つけた異常 → 解析役の agent を起動 → 結果を公開) ----------
ALERT_SEVERITIES="critical high medium low"
ANALYST_MAX=${TB_ANALYST_MAX:-2}
ANALYST_CWD=${TB_ANALYST_CWD:-$TB_ROOT/..}
ANALYST_MODEL=${TB_ANALYST_MODEL:-}
valid_aid() { [[ $1 =~ ^A-[0-9]+$ ]] || usage "アラート ID は A-<数字>: $1"; }
alert_row() { sql -json "SELECT * FROM alerts WHERE id=${1#A-};" | jq -c '.[0] // empty'; }

# tb alert: 登録。見張り役は「何が起きたか」だけを書く(緊急度は解析役が決める)。
# 同じ指紋(--key、無ければ題名)の未解決アラートがあれば件数を増やすだけ
# 出力: "A-<n> new|duplicate <status>"。新規なら続けて解析役の起動を試みる(approvals の alert:analyze)
cmd_alert() {
  local title="" body="" bfile="" key="" json=0
  while [[ $# -gt 0 ]]; do
    case $1 in
      --severity) usage "alert: 緊急度は解析役が tb alert-result --severity で決めます(見張り役は指定しない)";;
      --title) need_arg "$@"; title=$2; shift 2;;
      --body) need_arg "$@"; body=$2; shift 2;;
      --body-file) need_arg "$@"; bfile=$2; shift 2;;
      --key) need_arg "$@"; key=$2; shift 2;;
      --json) json=1; shift;;
      --from|--source|--name|--pane) usage "alert: 報告者は herdr から自動で決まります。$1 は指定できません";;
      *) usage "alert: 不明な引数 $1";;
    esac
  done
  blank "$title" && usage "alert: --title が必要です"
  if [[ -n $bfile ]]; then [[ -f $bfile && -r $bfile ]] || die "alert: --body-file を読めません: $bfile"; body=$(head -c 20000 "$bfile"); fi
  local src="cli" spane=""
  if [[ -n ${HERDR_PANE_ID:-} ]]; then resolve_label || return 3; src=$LABEL_NAME; spane=$LABEL_PANE; fi
  local fp; fp=$(printf '%s' "${key:-$title}" | sha256 | cut -c1-16)
  local dup; dup=$(sql "SELECT id FROM alerts WHERE fingerprint=$(q "$fp") AND status NOT IN ('analyzed','closed') ORDER BY id DESC LIMIT 1;")
  local id state ts; ts=$(now)
  if [[ -n $dup ]]; then
    sql "UPDATE alerts SET count=count+1, last_seen=$(q "$ts") WHERE id=$dup;"
    id=$dup; state=duplicate
  else
    id=$(sql "INSERT INTO alerts (fingerprint, title, body, source, source_pane, status, count, first_seen, last_seen)
      VALUES ($(q "$fp"), $(q "$title"), $(q "$body"), $(q "$src"), NULLIF($(q "$spane"),''), 'new', 1, $(q "$ts"), $(q "$ts"));
      SELECT last_insert_rowid();")
    state=new
  fi
  [[ $state == new ]] && { alert_dispatch_one "$id" >/dev/null 2>&1 || true; }
  if ((json)); then alert_row "$id" | jq -c '.id = "A-\(.id)"'
  else echo "A-$id $state $(sql "SELECT status FROM alerts WHERE id=$id;")"; fi
}

# 解析役を起動する。新規で approvals が ask なら awaiting-approval。上限に達していれば queued(承認は済んだ扱い)
alert_dispatch_one() {  # $1=alerts.id(数字)
  local id=$1 st
  st=$(sql "SELECT status FROM alerts WHERE id=$id;")
  [[ $st == new || $st == queued || $st == approved ]] || return 0
  if [[ $st == new ]]; then
    approval_of "alert:analyze"
    if [[ $APPROVAL_VALUE != allow ]]; then sql "UPDATE alerts SET status='awaiting-approval' WHERE id=$id;"; return 0; fi
  fi
  local busy; busy=$(sql "SELECT COUNT(*) FROM alerts WHERE status='analyzing';")
  if (( busy >= ANALYST_MAX )); then sql "UPDATE alerts SET status='queued' WHERE id=$id;"; return 0; fi
  start_analyst "$id"
}

start_analyst() {  # $1=alerts.id
  local id=$1 name="analyst-A$1" cwd pane out prompt
  cwd=$(cd "$ANALYST_CWD" 2>/dev/null && pwd) || { sql "UPDATE alerts SET status='queued', note='TB_ANALYST_CWD が無い' WHERE id=$id;"; return 11; }
  if ! out=$("$HERDR_BIN" workspace create --cwd "$cwd" --label "$name" --no-focus 2>&1) \
     || ! pane=$(jq -er '.result.root_pane.pane_id' <<<"$out" 2>/dev/null); then
    sql "UPDATE alerts SET status='queued', note='workspace を作れない' WHERE id=$id;"; return 11
  fi
  local -a extra=(); [[ -n $ANALYST_MODEL ]] && extra=(-- --model "$ANALYST_MODEL")
  local i ok=0
  for i in 1 2 3; do   # シェル初期化が遅いと最初の start が失敗する(herdr-up.sh と同じ)
    if "$HERDR_BIN" agent start "$name" --kind claude --pane "$pane" ${extra[@]+"${extra[@]}"} >/dev/null 2>&1; then ok=1; break; fi
    sleep "${TB_ANALYST_RETRY_SEC:-3}"
  done
  ((ok)) || { sql "UPDATE alerts SET status='queued', note='agent を起動できない' WHERE id=$id;"; return 11; }
  sql "UPDATE alerts SET status='analyzing', analyst=$(q "$name"), analysis_started_at=$(q "$(now)"), note=NULL WHERE id=$id;"
  prompt="[from: tb / alert / A-$id / task] あなたはアラート A-$id の解析役です(役割は roles/analyst.md)。まず tb alerts A-$id で全文を読み、原因の仮説・根拠・影響範囲・推奨対応をまとめ、緊急度を決めて、tb alert-result A-$id --severity critical|high|medium|low --summary '<要約>' --report <報告ファイル> で返してください。"
  # 起動直後は idle になるまで少し待つ(herdr_send は idle/done でしか送らない)
  for i in 1 2 3 4 5; do herdr_send "$name" "$prompt" "A-$id" alert 2>/dev/null && return 0; sleep "${TB_ANALYST_RETRY_SEC:-3}"; done
  sql "UPDATE alerts SET note='解析役に依頼を送れていない(tb alert-dispatch で再送)' WHERE id=$id;"
  return 10
}

# 承認待ち・上限待ちのアラートを進める(tb digest も最初に呼ぶ)。送れていない依頼も再送する
cmd_alert-dispatch() {
  local id
  while read -r id; do [[ -n $id ]] && { alert_dispatch_one "$id" || true; }; done < <(sql "SELECT id FROM alerts WHERE status IN ('new','queued','approved') ORDER BY id;")
  sql -separator ' ' "SELECT 'A-'||id, status FROM alerts WHERE status IN ('awaiting-approval','queued','analyzing') ORDER BY id;"
}

# 人が解析役の起動を承認する(approvals が ask のとき)。--always で alert:analyze を allow に
cmd_alert-approve() {
  [[ $# -ge 1 ]] || usage "alert-approve A-<n> [--always]"
  valid_aid "$1"; local id=${1#A-} always=0; shift
  [[ ${1:-} == --always ]] && always=1
  require_human "tb alert-approve"
  [[ $(sql "SELECT status FROM alerts WHERE id=$id;") == awaiting-approval ]] || die "A-$id は承認待ちではありません"
  sql "UPDATE alerts SET status='approved' WHERE id=$id;"
  ((always)) && set_approval allow "alert:analyze" >/dev/null && echo "alert:analyze = allow(今後は承認なし)"
  alert_dispatch_one "$id" >/dev/null 2>&1 || true
  echo "A-$id $(sql "SELECT status FROM alerts WHERE id=$id;")"
}

# 解析役が結果を返す。担当の解析役(または人)だけ
cmd_alert-result() {
  [[ $# -ge 1 ]] || usage "alert-result A-<n> --severity critical|high|medium|low --summary S [--report <ファイル>]"
  valid_aid "$1"; local id=${1#A-} summary="" report="" sev=""; shift
  while [[ $# -gt 0 ]]; do
    case $1 in
      --summary) need_arg "$@"; summary=$2; shift 2;;
      --report) need_arg "$@"; report=$2; shift 2;;
      --severity) need_arg "$@"; sev=$2; shift 2;;
      *) usage "alert-result: 不明な引数 $1";;
    esac
  done
  [[ " $ALERT_SEVERITIES " == *" $sev "* ]] || usage "alert-result: --severity は $ALERT_SEVERITIES のどれか(緊急度は解析役が決める)"
  blank "$summary" && usage "alert-result: --summary が必要です"
  local row; row=$(alert_row "$id"); [[ -n $row ]] || die "アラートが見つかりません: A-$id"
  local by="human"
  if [[ -n ${HERDR_PANE_ID:-} ]]; then
    resolve_label || return 3
    [[ $LABEL_NAME == "$(jq -r '.analyst // ""' <<<"$row")" ]] || die "A-$id の解析役ではありません($LABEL_NAME)"
    by=$LABEL_NAME
  fi
  [[ $(jq -r .status <<<"$row") != closed ]] || die "A-$id は閉じています"
  local rtext=""; if [[ -n $report ]]; then [[ -f $report && -r $report ]] || die "--report を読めません: $report"; rtext=$(head -c 50000 "$report"); fi
  sql "UPDATE alerts SET status='analyzed', severity=$(q "$sev"), result_summary=$(q "$summary"), result_report=NULLIF($(q "$rtext"),''),
         result_path=NULLIF($(q "$report"),''), result_by=$(q "$by"), analyzed_at=$(q "$(now)") WHERE id=$id;"
  alert_deliver "$id" >/dev/null 2>&1 || true
  cmd_alert-dispatch >/dev/null 2>&1 || true   # 枠が空いたので待ちを進める
  echo "A-$id analyzed"
}

# 解析結果を指揮官へ(使用中なら tb digest が回収する)
alert_deliver() {  # $1=id
  local row msg target
  row=$(alert_row "$1"); [[ -n $row && $(jq -r '.result_delivered_at // ""' <<<"$row") == "" ]] || return 0
  target=$DEFAULT_TARGET
  msg="[alert A-$1 analyzed / $(jq -r .severity <<<"$row")] $(oneline "$(jq -r .title <<<"$row")" 80) — $(oneline "$(jq -r .result_summary <<<"$row")" 300) (全文: tb alerts A-$1)"
  herdr_send "$target" "$msg" "A-$1" alert || return $?
  sql "UPDATE alerts SET result_delivered_at=$(q "$(now)") WHERE id=$1;"
}

cmd_alert-close() {
  [[ $# -eq 1 ]] || usage "alert-close A-<n>"
  valid_aid "$1"; require_human "tb alert-close"
  sql "UPDATE alerts SET status='closed', closed_at=$(q "$(now)") WHERE id=${1#A-};"
  echo "$1 closed"
}

cmd_alerts() {
  local json=0 st=""
  if [[ ${1:-} == A-* ]]; then
    valid_aid "$1"; local row; row=$(alert_row "$1"); [[ -n $row ]] || die "アラートが見つかりません: $1"
    [[ ${2:-} == --json ]] && { jq -c '.id = "A-\(.id)"' <<<"$row"; return 0; }
    jq -r '"A-\(.id) [\(.severity // "未解析")] \(.status) ×\(.count)  \(.title)\n報告: \(.source) / 初回 \(.first_seen) / 最終 \(.last_seen)\n解析役: \(.analyst // "-")\n\n\(.body // "")\n" +
      (if .result_summary then "---- 解析結果(\(.result_by), \(.analyzed_at))\n\(.result_summary)\n\n\(.result_report // "")" else "" end)' <<<"$row"
    return 0
  fi
  while [[ $# -gt 0 ]]; do
    case $1 in
      --json) json=1; shift;;
      --status) need_arg "$@"; st=$2; shift 2;;
      *) usage "alerts: 不明な引数 $1";;
    esac
  done
  local where="1=1"; [[ -z $st ]] || where="status=$(q "$st")"
  if ((json)); then sql -json "SELECT * FROM alerts WHERE $where ORDER BY id DESC LIMIT 100;" | jq -c '(. // [])[] | .id = "A-\(.id)"'
  else sql -nullvalue - -separator $'\t' "SELECT 'A-'||id, COALESCE(severity,'未解析'), status, count, COALESCE(analyst,'-'), last_seen, title FROM alerts WHERE $where ORDER BY id DESC LIMIT 100;"; fi
}

# scheduler(tick.sh)からのプロンプト送信。agent の pane からは使えない。記録は messages(kind=scheduler)
cmd_system-send() {
  [[ $# -ge 3 && $2 == --text ]] || usage "system-send <宛先> --text T --job J"
  local target=$1 text=$3 job=""; shift 3
  [[ ${1:-} == --job ]] && job=${2:-}
  [[ $job =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || usage "system-send: --job が必要です"
  require_human "tb system-send"
  herdr_send "$target" "$text" "job:$job" scheduler
}

cmd_help() {
  cat <<'USAGE'
tb add -p <project> -t <title> [--parent ID] [--owner N] [--session S] [--account A]   → ID を表示
tb list [-p project] [-s status] [--json]
tb show <id>
tb claim <id> --owner <name> [--session S] [--account A]    todo → in_progress(todo 以外は失敗)
tb update <id> [--status todo|in_progress|review|blocked] [--title T] [--owner N] [--session S] [--account A] [--parent ID]
tb done <id> -d <成果物> [-d ...] -m <要約>                  成果物と要約が必須。reported_at は空のまま
tb block <id> [-m <理由>]
tb report <id>      指示役へ [T-xxx done] ... を送る。成功時のみ reported_at を埋める
                    終了コード 0=送信済み/報告済み 10=宛先が使用中で未送信 11=送信/状態取得に失敗
tb pending [--json|--ids]   done なのに未報告のタスク

代行依頼(判定と記録だけ。cmd は tb が実行しない):
tb proxy-request <task-id> --cmd C --why W --effect read-only|write|external [--expect E]   → "<id> <status>"
tb proxy-list [--status open|done|pending-human|denied] [--json]
tb proxy-resolve <id> --status done|pending-human|denied [--result <本文かファイルパス>]
tb proxy-check <id>   1 行目が allow(自動代行可)か human(人に回す)。mismatch: があれば申告の食い違い

agent の活動記録(hook から。bin/tb-hook 経由が基本):
tb touch --event UserPromptSubmit|Stop --session-id S [--pane-id P] [--tab-id T] [--workspace-id W] [--cwd D] [--prompt-id I]
         常に終了コード 0・出力なし。失敗は data/touch-errors.log に 1 行(理由コードのみ)
tb activity [--json] [--stuck-min N]   最終入力・最終停止・working 推定・滞留(既定 10 分)

報告コメント(worker → 指揮官。報告者は HERDR_PANE_ID と herdr agent list から決まり、上書きできない):
tb comment <task-id> --kind done|progress|question|blocked --text T [--deliverables a,b] [--json]
         保存してから送る。終了コード 0=配送済み 10=保存済み・宛先使用中 11=保存済み・送信失敗 3=報告者を特定できず未保存
tb comments [<task-id>] [--kind K] [--undelivered] [--json]
         未配送は tb pending に C-<n> として出る。tb report C-<n> で再送
         question/blocked はすぐ送る。done/progress は保存だけして tb digest でまとめて送る(TB_IMMEDIATE_KINDS で変更)

まとめ送信(scheduler から 10 分おきに呼ぶ想定):
tb digest [--dry-run]   未配送の報告・未報告の done・観測した事象(turn 終了後も in_progress / 長時間 working / blocked)を
                        指揮官ごとに 1 通にまとめて送る。宛先が使用中なら送らず次回へ持ち越す。終了コード 0 / 10 / 11
tb digests [D-<n>] [--json]   送ったまとめの一覧 / 全文

指揮官 → worker の送信(herdr agent prompt を直接打たない。送信者は herdr から決まり、config/routes.conf のルールで許可されたものだけ届く):
tb send <宛先 agent 名> --text T [--task T-..] [--kind task|info|answer] [--json]
         終了コード 0=送信済み 10=宛先使用中で outbox に積んだ 11=送信失敗で積んだ 4=ルールで拒否 20=人の承認待ち 3=送信者を特定できず未保存
tb flush            積まれた送信を届ける(tb digest も最初に呼ぶ)
tb outbox [--status pending|queued|sent|denied] [--json]

役割の配布(roles/。SessionStart hook は bin/tb-role-hook 経由):
tb role-context --source startup|resume|clear|compact --session-id S   hook 用。渡すときだけ hook の JSON を出す。常に 0
tb role-broadcast [agent 名 ...]   動いている agent に役割の置き場所を送る(同じ版を渡し済みのセッションは飛ばす)
tb roles [--json]                  agent ごとの役割ファイルと、渡した版が最新か(current|outdated|never|no-role)

人の承認(config/approvals.conf。<操作のパターン> = ask|allow、最初に一致した行、無一致は ask):
tb approval <操作>        1 行目 ask|allow、2 行目 rule:。終了コード 0=allow 20=ask(例: send:task:worker1, role:change, setup:hooks)
tb allow <パターン>       今後は承認なしにする(人の端末からだけ)。tb ask <パターン> で承認制に戻す
tb approve O-<n> [--always]   承認待ちの送信を届ける。--always なら send:<kind>:<宛先> を allow にする
tb reject O-<n>               承認待ちの送信を却下する

アラート(見張り役 → 解析役の agent を起動 → 結果を指揮官・Web UI へ):
tb alert --title T [--body B|--body-file F] [--key K] [--json]   見張り役が登録(緊急度は付けない)
         → "A-<n> new|duplicate <status>"。新規なら approvals の alert:analyze を見て解析役を起動
tb alerts [A-<n>] [--status S] [--json]    一覧 / 全文と解析結果
tb alert-approve A-<n> [--always]          人が解析役の起動を承認(--always で今後は承認なし)
tb alert-result A-<n> --severity critical|high|medium|low --summary S [--report F]   解析役が緊急度と結果を返す(担当の解析役か人だけ)
tb alert-dispatch                          承認・上限待ちを進める(tb digest も呼ぶ)
tb alert-close A-<n>                       人が閉じる
tb system-send <宛先> --text T --job J      scheduler 用。agent の pane からは使えない
USAGE
}

main() {
  local cmd=${1:-help}; shift || true
  case $cmd in
    help|-h|--help) cmd_help; return 0;;
    touch) cmd_touch "$@"; return 0;;   # 常に 0。ツールの有無チェックや init_db の失敗でも止めない
    role-context) ( need_tools && init_db ) >/dev/null 2>&1 && cmd_role-context "$@" 2>/dev/null; return 0;;   # hook 用。常に 0
    add|list|show|claim|update|done|block|report|pending|activity) ;;
    proxy-request|proxy-list|proxy-resolve|proxy-check|comment|comments|digest|digests|send|flush|outbox|role-broadcast|roles|approval|allow|ask|approve|reject|alert|alerts|alert-dispatch|alert-approve|alert-result|alert-close|system-send) ;;
    *) usage "不明なコマンド: $cmd";;
  esac
  need_tools
  init_db
  migrate_db
  "cmd_$cmd" "$@"
}
main "$@"
